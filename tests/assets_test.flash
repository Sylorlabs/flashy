    svg_free(&nonnumeric_curve); svg_free(&overflow_curve); svg_free(&relative_overflow_curve); svg_free(&truncated_line);
    svg_free(&truncated_smooth_quadratic); svg_free(&truncated_smooth_cubic); svg_free(&nonnumeric_smooth);
    svg_free(&relative_overflow_smooth); svg_free(&reflected_quadratic_overflow); svg_free(&reflected_cubic_overflow);
    svg_free(&arc_small_sweep_relative); svg_free(&arc_diagonal); svg_free(&arc_diagonal_relative);
    svg_free(&arc_small_reverse); svg_free(&arc_large_sweep); svg_free(&arc_large_reverse);
    svg_free(&arc_repeated); svg_free(&arc_repeated_relative); svg_free(&arc_corrected_radius); svg_free(&arc_explicit_radius);
    svg_free(&arc_zero_radius); svg_free(&arc_zero_radius_line); svg_free(&arc_same_endpoint);
    svg_free(&arc_small_sweep);
    failures = failures + asset_expect(arc_small_sweep.valid == 0
        && len[SvgShape](arc_small_sweep.document.shapes) == 0,
        "arc cleanup releases flattened endpoint geometry");
    svg_free(&truncated_arc); svg_free(&truncated_repeated_arc); svg_free(&negative_radius_arc);
    svg_free(&bad_large_flag_arc); svg_free(&bad_sweep_flag_arc); svg_free(&joined_flag_arc);
    svg_free(&rotated_arc); svg_free(&overflow_arc);
    svg_free(&decimal_curve); svg_free(&multiple_subpath); svg_free(&nonterminal_close);
    free[u8](&segment_data); free[Point2D](&bounded_shape.points);
    free[u8](&arc_segment_data); free[Point2D](&arc_bounded_shape.points);
    svg_free(&curve_absolute);
    failures = failures + asset_expect(curve_absolute.valid == 0 && curve_absolute.document.width == 0
        && curve_absolute.document.height == 0 && len[SvgShape](curve_absolute.document.shapes) == 0,
        "SVG curve document cleanup releases retained shapes and resets owned geometry");

    let missing: SvgResult = svg_parse("<svg><rect width=\"1\" height=\"1\" fill=\"#000000\"/></svg>");
    failures = failures + asset_expect(missing.valid == 0 && missing.error == AssetError.MissingSize,
        "missing viewport size returns typed error");
    let bad_color: SvgResult = svg_parse("<svg width=\"1\" height=\"1\"><rect width=\"1\" height=\"1\" fill=\"red\"/></svg>");
    failures = failures + asset_expect(bad_color.valid == 0 && bad_color.error == AssetError.InvalidColor,
        "unsupported color syntax returns typed error");
    let bad_number: SvgResult = svg_parse("<svg width=\"27\" height=\"27\"><circle cx=\"x\" cy=\"1\" r=\"1\" fill=\"#000000\"/></svg>");
    failures = failures + asset_expect(bad_number.valid == 0 && bad_number.error == AssetError.InvalidNumber,
        "malformed geometry returns typed error");

    raw_pixel_free(&raw_decoded); raw_pixel_free(&invalid_raw); raw_pixel_free(&short_raw);
    raw_pixel_free(&bad_stride); raw_pixel_free(&trailing_raw); raw_pixel_free(&bad_dimensions);
    raw_pixel_free(&missing_raw);
    free[u8](&fixed_zlib); free[u8](&fixed_inflate.bytes);
    free[u8](&dynamic_zlib); free[u8](&dynamic_inflate.bytes);
    surface_free(&png_surface); png_encode_free(&encoded_png); png_free(&decoded_png); png_free(&loaded_png);
    png_free(&bad_signature_png);
    free[u8](&gray_raw); free[u8](&gray_png_bytes); png_free(&gray_png);
    free[u8](&rgb_raw); free[u8](&rgb_png_bytes); png_free(&rgb_png);
    free[u8](&gray_alpha_raw); free[u8](&gray_alpha_bytes); png_free(&gray_alpha_png);
    free[u8](&packed_gray_raw); free[u8](&packed_gray_bytes); png_free(&packed_gray_png);
    free[u8](&palette_raw); free[u8](&palette_data); free[u8](&palette_alpha);
    free[u8](&palette_png_bytes); png_free(&palette_png);
    free[u8](&gray_trns_raw); free[u8](&gray_trns_data); free[u8](&gray_trns_bytes); png_free(&gray_trns_png);
    free[u8](&rgba16_raw); free[u8](&rgba16_bytes); png_free(&rgba16_png); free[u8](&no_metadata);
    surface_free(&adam7_surface); free[u8](&adam7_raw); free[u8](&adam7_bytes); png_free(&adam7_png);
    free[u8](&bad_adam7_raw); free[u8](&bad_adam7_bytes); png_free(&bad_adam7_png);
    free[u8](&unsupported_interlace); png_free(&interlace_result);
    free[u8](&apng_frame1_raw); free[u8](&apng_frame1_data);
    free[u8](&apng_frame2_raw); free[u8](&apng_frame2_data);
    free[u8](&apng_frame3_raw); free[u8](&apng_frame3_data);
    free[u8](&apng_frame4_raw); free[u8](&apng_frame4_data); free[u8](&apng_bytes);
    png_animation_free(&animation); png_animation_free(&loaded_animation); png_animation_free(&static_animation);
    png_encode_free(&canonical_encoded); png_animation_free(&canonical_animation);
    surface_free(&source2); surface_free(&source3); surface_free(&source4);
    free[PngAnimationSourceFrame](&encode_sources); png_encode_free(&encoded_animation);
    png_animation_free(&encoded_animation_roundtrip); png_encode_free(&invalid_animation_encode);
    free[u8](&bad_sequence_apng); png_animation_free(&bad_sequence_result);
    free[u8](&unsupported_depth); png_free(&depth_result);
    free[u8](&corrupted_png); png_free(&corrupt_result);
    jpeg_free(&jpeg_decoded); jpeg_free(&progressive_decode_pending); jpeg_free(&loaded_jpeg); jpeg_free(&gray_jpeg); jpeg_free(&y420_jpeg);
    jpeg_free(&baseline_multiscan);
    jpeg_free(&progressive_gray); jpeg_free(&progressive_color);
    jpeg_free(&restart_jpeg); jpeg_free(&wrong_restart_jpeg);
    free[u8](&jpeg_bytes); free[u8](&gray_jpeg_bytes); free[u8](&y420_jpeg_bytes); free[u8](&restart_jpeg_bytes);
    free[u8](&baseline_multiscan_bytes);
    free[u8](&progressive_gray_bytes); free[u8](&progressive_color_bytes);
    free[u8](&raw); free[u8](&invalid_premultiplied);
    surface_free(&rendered); svg_free(&parsed); svg_free(&missing); svg_free(&bad_color); svg_free(&bad_number);
    if (failures != 0) {
        _zag_print("svg_checksum="); _zag_println(_zag_i64_to_str(checksum as i64));
        _zag_print("svg_curve_checksum="); _zag_println(_zag_i64_to_str(curve_checksum as i64));
        _zag_print("svg_curve_scaled_checksum="); _zag_println(_zag_i64_to_str(curve_scaled_checksum as i64));
        _zag_print("svg_smooth_quadratic_checksum="); _zag_println(_zag_i64_to_str(smooth_quadratic_checksum as i64));
        _zag_print("svg_smooth_cubic_checksum="); _zag_println(_zag_i64_to_str(smooth_cubic_checksum as i64));
        _zag_print("svg_smooth_reset_checksum="); _zag_println(_zag_i64_to_str(smooth_reset_checksum as i64));
        _zag_print("svg_arc_small_checksum="); _zag_println(_zag_i64_to_str(arc_small_checksum as i64));
        _zag_print("svg_arc_small_reverse_checksum="); _zag_println(_zag_i64_to_str(arc_small_reverse_checksum as i64));
        _zag_print("svg_arc_large_checksum="); _zag_println(_zag_i64_to_str(arc_large_checksum as i64));
        _zag_print("svg_arc_large_reverse_checksum="); _zag_println(_zag_i64_to_str(arc_large_reverse_checksum as i64));
        return 1;
    }
    _zag_println("assets_test: ok"); return 0;
}
