@import("../src/flashy.flash")

fn asset_expect(ok: i32, message: []u8) i32 {
    if (ok == 0) { _zag_print("FAIL "); _zag_println(message); return 1; }
    return 0;
}

fn asset_append_ascii(bytes: *ArrayList[u8], text: []u8) void {
    let i: i32 = 0;
    while (i < text.len) { push[u8](bytes, text[i]); i = i + 1; }
}

fn asset_svg_path_points_equal(left: *SvgResult, right: *SvgResult) i32 {
    if (left.*.valid == 0 || right.*.valid == 0
        || len[SvgShape](left.*.document.shapes) != 1 || len[SvgShape](right.*.document.shapes) != 1) { return 0; }
    let left_shape: SvgShape = get[SvgShape](left.*.document.shapes, 0);
    let right_shape: SvgShape = get[SvgShape](right.*.document.shapes, 0);
    if (left_shape.closed != right_shape.closed || len[Point2D](left_shape.points) != len[Point2D](right_shape.points)) {
        return 0;
    }
    let i: i32 = 0;
    while (i < len[Point2D](left_shape.points)) {
        if (left_shape.points.data[i].x != right_shape.points.data[i].x
            || left_shape.points.data[i].y != right_shape.points.data[i].y) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn asset_hex_bytes(text: []u8) ArrayList[u8] {
    let bytes: ArrayList[u8] = make[u8](text.len / 2);
    if ((text.len % 2) != 0) { return bytes; }
    let i: i32 = 0;
    while (i < text.len) {
        let high: t27 = svg_hex_digit(text[i] as t27);
        let low: t27 = svg_hex_digit(text[i + 1] as t27);
        if (high < 0 || low < 0) { free[u8](&bytes); return make[u8](0); }
        push[u8](&bytes, (high * 16 + low) as u8);
        i = i + 2;
    }
    return bytes;
}

fn asset_filter_case(filter: t27, row0a: t27, row0b: t27, row0c: t27,
    row1a: t27, row1b: t27, row1c: t27) i32 {
    let encoded: ArrayList[u8] = make[u8](8);
    push[u8](&encoded, filter as u8); push[u8](&encoded, row0a as u8);
    push[u8](&encoded, row0b as u8); push[u8](&encoded, row0c as u8);
    push[u8](&encoded, filter as u8); push[u8](&encoded, row1a as u8);
    push[u8](&encoded, row1b as u8); push[u8](&encoded, row1c as u8);
    let ok: i32 = 0;
    let decoded: ArrayList[u8] = png_unfilter(&encoded, 3, 2, 1, &ok);
    let valid: i32 = ok == 1 && len[u8](decoded) == 6
        && decoded.data[0] == 10 && decoded.data[1] == 20 && decoded.data[2] == 30
        && decoded.data[3] == 15 && decoded.data[4] == 25 && decoded.data[5] == 35;
    free[u8](&encoded); free[u8](&decoded);
    return valid;
}

fn asset_make_png_with_metadata(width: t27, height: t27, bit_depth: t27, color_type: t27, interlace: t27,
    raw: *ArrayList[u8], palette: *ArrayList[u8], transparency: *ArrayList[u8]) ArrayList[u8] {
    let output: ArrayList[u8] = make[u8](96);
    push[u8](&output, 137 as u8); push[u8](&output, 80 as u8); push[u8](&output, 78 as u8);
    push[u8](&output, 71 as u8); push[u8](&output, 13 as u8); push[u8](&output, 10 as u8);
    push[u8](&output, 26 as u8); push[u8](&output, 10 as u8);
    let header: ArrayList[u8] = make[u8](13);
    png_push_u32_be(&header, width); png_push_u32_be(&header, height);
    push[u8](&header, bit_depth as u8); push[u8](&header, color_type as u8);
    push[u8](&header, 0 as u8); push[u8](&header, 0 as u8); push[u8](&header, interlace as u8);
    png_append_chunk(&output, "IHDR", &header);
    if (len[u8](palette.*) > 0) { png_append_chunk(&output, "PLTE", palette); }
    if (len[u8](transparency.*) > 0) { png_append_chunk(&output, "tRNS", transparency); }
    let compressed: ArrayList[u8] = png_zlib_store(raw);
    png_append_chunk(&output, "IDAT", &compressed);
    let empty: ArrayList[u8] = make[u8](0);
    png_append_chunk(&output, "IEND", &empty);
    free[u8](&header); free[u8](&compressed); free[u8](&empty);
    return output;
}

fn asset_make_png(width: t27, height: t27, color_type: t27, raw: *ArrayList[u8]) ArrayList[u8] {
    let empty_palette: ArrayList[u8] = make[u8](0);
    let empty_transparency: ArrayList[u8] = make[u8](0);
    let output: ArrayList[u8] = asset_make_png_with_metadata(width, height, 8, color_type, 0,
        raw, &empty_palette, &empty_transparency);
    free[u8](&empty_palette); free[u8](&empty_transparency);
    return output;
}

fn asset_adam7_rgba_raw(surface: *Surface) ArrayList[u8] {
    let raw: ArrayList[u8] = make[u8](((surface.*.width * 4 + 1) * surface.*.height) as i32);
    let pass: i32 = 0;
    while (pass < 7) {
        let start_x: t27 = png_adam7_start_x(pass); let start_y: t27 = png_adam7_start_y(pass);
        let step_x: t27 = png_adam7_step_x(pass); let step_y: t27 = png_adam7_step_y(pass);
        let pass_width: t27 = png_adam7_extent(surface.*.width, start_x, step_x);
        let pass_height: t27 = png_adam7_extent(surface.*.height, start_y, step_y);
        let pass_y: t27 = 0;
        while (pass_y < pass_height) {
            push[u8](&raw, 0 as u8);
            let pass_x: t27 = 0;
            while (pass_x < pass_width) {
                let source_x: t27 = start_x + pass_x * step_x;
                let source_y: t27 = start_y + pass_y * step_y;
                let offset: i32 = ((source_y * surface.*.width + source_x) * 4) as i32;
                push[u8](&raw, surface.*.pixels.data[offset]); push[u8](&raw, surface.*.pixels.data[offset + 1]);
                push[u8](&raw, surface.*.pixels.data[offset + 2]); push[u8](&raw, surface.*.pixels.data[offset + 3]);
                pass_x = pass_x + 1;
            }
            pass_y = pass_y + 1;
        }
        pass = pass + 1;
    }
    return raw;
}

fn asset_set_u32_be(bytes: *ArrayList[u8], offset: i32, value: t27) void {
    bytes.*.data[offset] = ((value / 16777216) % 256) as u8;
    bytes.*.data[offset + 1] = ((value / 65536) % 256) as u8;
    bytes.*.data[offset + 2] = ((value / 256) % 256) as u8;
    bytes.*.data[offset + 3] = (value % 256) as u8;
}

fn asset_copy_bytes(source: *ArrayList[u8]) ArrayList[u8] {
    let copy: ArrayList[u8] = make[u8](len[u8](source.*));
    let i: i32 = 0;
    while (i < len[u8](source.*)) { push[u8](&copy, source.*.data[i]); i = i + 1; }
    return copy;
}

fn asset_copy_slice(source: []u8) ArrayList[u8] {
    let copy: ArrayList[u8] = make[u8](source.len);
    let i: i32 = 0;
    while (i < source.len) { push[u8](&copy, source[i]); i = i + 1; }
    return copy;
}

fn asset_push_u16_be(out: *ArrayList[u8], value: t27) void {
    push[u8](out, ((value / 256) % 256) as u8); push[u8](out, (value % 256) as u8);
}

fn asset_apng_begin(width: t27, height: t27, frame_count: t27, play_count: t27) ArrayList[u8] {
    let output: ArrayList[u8] = make[u8](256);
    push[u8](&output, 137 as u8); push[u8](&output, 80 as u8); push[u8](&output, 78 as u8);
    push[u8](&output, 71 as u8); push[u8](&output, 13 as u8); push[u8](&output, 10 as u8);
    push[u8](&output, 26 as u8); push[u8](&output, 10 as u8);
    let header: ArrayList[u8] = make[u8](13);
    png_push_u32_be(&header, width); png_push_u32_be(&header, height);
    push[u8](&header, 8 as u8); push[u8](&header, 6 as u8); push[u8](&header, 0 as u8);
    push[u8](&header, 0 as u8); push[u8](&header, 0 as u8);
    png_append_chunk(&output, "IHDR", &header);
    let animation: ArrayList[u8] = make[u8](8);
    png_push_u32_be(&animation, frame_count); png_push_u32_be(&animation, play_count);
    png_append_chunk(&output, "acTL", &animation);
    free[u8](&header); free[u8](&animation);
    return output;
}

fn asset_apng_control(output: *ArrayList[u8], sequence: t27, width: t27, height: t27,
    x: t27, y: t27, delay_numerator: t27, delay_denominator: t27, dispose: t27, blend: t27) void {
    let control: ArrayList[u8] = make[u8](26);
    png_push_u32_be(&control, sequence); png_push_u32_be(&control, width); png_push_u32_be(&control, height);
    png_push_u32_be(&control, x); png_push_u32_be(&control, y);
    asset_push_u16_be(&control, delay_numerator); asset_push_u16_be(&control, delay_denominator);
    push[u8](&control, dispose as u8); push[u8](&control, blend as u8);
    png_append_chunk(output, "fcTL", &control); free[u8](&control);
}

fn asset_apng_frame_data(output: *ArrayList[u8], sequence: t27, compressed: *ArrayList[u8]) void {
    let data: ArrayList[u8] = make[u8](len[u8](compressed.*) + 4);
    png_push_u32_be(&data, sequence);
    let i: i32 = 0; while (i < len[u8](compressed.*)) { push[u8](&data, compressed.*.data[i]); i = i + 1; }
    png_append_chunk(output, "fdAT", &data); free[u8](&data);
}

fn asset_apng_end(output: *ArrayList[u8]) void {
    let empty: ArrayList[u8] = make[u8](0); png_append_chunk(output, "IEND", &empty); free[u8](&empty);
}

fn main() i32 {
    let failures: i32 = 0;

    let jpeg_bytes: ArrayList[u8] = asset_hex_bytes("");
    let jpeg_info: JpegInfoResult = jpeg_probe(jpeg_bytes.data[0..jpeg_bytes.len]);
    failures = failures + asset_expect(jpeg_info.valid == 1 && jpeg_info.error == JpegError.None
        && jpeg_info.width == 2 && jpeg_info.height == 2 && jpeg_info.components == 3
        && jpeg_info.scans == 1, "baseline JPEG marker and scan contract");
    let jpeg_decoded: JpegDecodeResult = jpeg_decode(jpeg_bytes.data[0..jpeg_bytes.len]);
    failures = failures + asset_expect(jpeg_decoded.valid == 1 && jpeg_decoded.error == JpegError.None
        && jpeg_decoded.width == 2 && jpeg_decoded.height == 2, "baseline JPEG decodes to a CPU surface");
    if (jpeg_decoded.valid == 1) {
        failures = failures + asset_expect(jpeg_decoded.surface.pixels.data[0] >= 198
            && jpeg_decoded.surface.pixels.data[0] <= 210 && jpeg_decoded.surface.pixels.data[1] >= 45
            && jpeg_decoded.surface.pixels.data[1] <= 57 && jpeg_decoded.surface.pixels.data[2] >= 96
            && jpeg_decoded.surface.pixels.data[2] <= 108 && jpeg_decoded.surface.pixels.data[3] == 255,
            "baseline JPEG deterministic YCbCr conversion");
    }
    let jpeg_write_ok: i32 = _zag_write_file(".build/assets_baseline.jpg", jpeg_bytes.data[0..jpeg_bytes.len]);
    let loaded_jpeg: JpegDecodeResult = jpeg_load_file(".build/assets_baseline.jpg");
    failures = failures + asset_expect(jpeg_write_ok == 0 && loaded_jpeg.valid == 1
        && surface_checksum(&loaded_jpeg.surface) == surface_checksum(&jpeg_decoded.surface),
        "baseline JPEG filesystem loading matches memory decode");
    jpeg_bytes.data[159] = 194 as u8;
    let progressive_jpeg: JpegInfoResult = jpeg_probe(jpeg_bytes.data[0..jpeg_bytes.len]);
    let progressive_decode_pending: JpegDecodeResult = jpeg_decode(jpeg_bytes.data[0..jpeg_bytes.len]);
    failures = failures + asset_expect(progressive_jpeg.valid == 1 && progressive_jpeg.progressive == 1
        && progressive_decode_pending.valid == 0 && progressive_decode_pending.error == JpegError.BadScan,
        "sequential scan parameters relabeled as progressive are rejected");
    jpeg_bytes.data[159] = 192 as u8;
    let truncated_jpeg: JpegInfoResult = jpeg_probe(jpeg_bytes.data[0..280]);
    failures = failures + asset_expect(truncated_jpeg.valid == 0
        && truncated_jpeg.error == JpegError.Truncated, "truncated JPEG entropy data is bounded");
    let jpeg_prefix: i32 = 0; let all_prefixes_rejected: i32 = 1;
    while (jpeg_prefix < jpeg_bytes.len) {
        let prefix_result: JpegDecodeResult = jpeg_decode(jpeg_bytes.data[0..jpeg_prefix]);
        if (prefix_result.valid == 1) { all_prefixes_rejected = 0; }
        jpeg_free(&prefix_result); jpeg_prefix = jpeg_prefix + 1;
    }
    failures = failures + asset_expect(all_prefixes_rejected == 1,
        "every truncated JPEG prefix returns a bounded typed failure");
    let missing_jpeg: JpegInfoResult = jpeg_probe_file(".build/does-not-exist.jpg");
    failures = failures + asset_expect(missing_jpeg.valid == 0 && missing_jpeg.error == JpegError.Io,
        "missing JPEG returns typed IO error");
    let gray_jpeg_bytes: ArrayList[u8] = asset_hex_bytes("");
    let gray_jpeg: JpegDecodeResult = jpeg_decode(gray_jpeg_bytes.data[0..gray_jpeg_bytes.len]);
    failures = failures + asset_expect(gray_jpeg.valid == 1 && gray_jpeg.width == 9 && gray_jpeg.height == 7,
        "grayscale JPEG with partial edge block decodes");
    let y420_jpeg_bytes: ArrayList[u8] = asset_hex_bytes("");
    let y420_jpeg: JpegDecodeResult = jpeg_decode(y420_jpeg_bytes.data[0..y420_jpeg_bytes.len]);
    failures = failures + asset_expect(y420_jpeg.valid == 1 && y420_jpeg.width == 17 && y420_jpeg.height == 9,
        "4:2:0 JPEG sampling and partial MCU edges decode");
    failures = failures + asset_expect(gray_jpeg.valid == 1
        && surface_checksum(&gray_jpeg.surface) == 370201457, "grayscale JPEG deterministic pixel golden");
    failures = failures + asset_expect(y420_jpeg.valid == 1
        && surface_checksum(&y420_jpeg.surface) == 573148659, "4:2:0 JPEG deterministic pixel golden");
    let baseline_multiscan_embedded: []u8 = _zag_read_file("tests/fixtures/baseline-multiscan.jpg");
    let baseline_multiscan_bytes: ArrayList[u8] = asset_copy_slice(baseline_multiscan_embedded);
    let baseline_multiscan_info: JpegInfoResult = jpeg_probe(baseline_multiscan_bytes.data[0..baseline_multiscan_bytes.len]);
    let baseline_multiscan: JpegDecodeResult = jpeg_decode(baseline_multiscan_bytes.data[0..baseline_multiscan_bytes.len]);
    failures = failures + asset_expect(baseline_multiscan_info.valid == 1 && baseline_multiscan_info.progressive == 0
        && baseline_multiscan_info.scans == 3 && baseline_multiscan.valid == 1 && baseline_multiscan.width == 8
        && baseline_multiscan.height == 8 && surface_checksum(&baseline_multiscan.surface) == 645158062,
        "three-scan non-interleaved baseline JPEG decodes deterministically");
    let progressive_gray_embedded: []u8 = _zag_read_file("tests/fixtures/progressive-gray.jpg");
    let progressive_gray_bytes: ArrayList[u8] = asset_copy_slice(progressive_gray_embedded);
    let progressive_gray_info: JpegInfoResult = jpeg_probe(progressive_gray_bytes.data[0..progressive_gray_bytes.len]);
    let progressive_gray: JpegDecodeResult = jpeg_decode(progressive_gray_bytes.data[0..progressive_gray_bytes.len]);
    failures = failures + asset_expect(progressive_gray_info.valid == 1 && progressive_gray_info.progressive == 1
        && progressive_gray_info.scans == 6 && progressive_gray.valid == 1 && progressive_gray.width == 9
        && progressive_gray.height == 7 && surface_checksum(&progressive_gray.surface) == 370201457,
        "six-scan progressive grayscale JPEG decodes deterministically");
    let progressive_color_embedded: []u8 = _zag_read_file("tests/fixtures/progressive420.jpg");
    let progressive_color_bytes: ArrayList[u8] = asset_copy_slice(progressive_color_embedded);
    let progressive_color_info: JpegInfoResult = jpeg_probe(progressive_color_bytes.data[0..progressive_color_bytes.len]);
    let progressive_color: JpegDecodeResult = jpeg_decode(progressive_color_bytes.data[0..progressive_color_bytes.len]);
    failures = failures + asset_expect(progressive_color_info.valid == 1 && progressive_color_info.progressive == 1
        && progressive_color_info.scans == 10 && progressive_color.valid == 1 && progressive_color.width == 17
        && progressive_color.height == 9 && surface_checksum(&progressive_color.surface) == 544336024,
        "ten-scan progressive 4:2:0 JPEG decodes deterministically");
    progressive_color_bytes.data[648] = 48 as u8;
    let invalid_refinement: JpegDecodeResult = jpeg_decode(progressive_color_bytes.data[0..progressive_color_bytes.len]);
    failures = failures + asset_expect(invalid_refinement.valid == 0 && invalid_refinement.error == JpegError.BadScan,
        "out-of-order progressive successive approximation is rejected");
    jpeg_free(&invalid_refinement); progressive_color_bytes.data[648] = 16 as u8;
    progressive_color_bytes.data[231] = 9 as u8;
    let unknown_scan_component: JpegDecodeResult = jpeg_decode(progressive_color_bytes.data[0..progressive_color_bytes.len]);
    failures = failures + asset_expect(unknown_scan_component.valid == 0 && unknown_scan_component.error == JpegError.BadScan,
        "progressive scans cannot name a component absent from the frame");
    jpeg_free(&unknown_scan_component); progressive_color_bytes.data[231] = 1 as u8;
    let progressive_write_ok: i32 = _zag_write_file(".build/assets_progressive.jpg",
        progressive_color_bytes.data[0..progressive_color_bytes.len]);
    failures = failures + asset_expect(progressive_write_ok == 0, "progressive JPEG fixture is available to CLI validation");
    let progressive_prefix: i32 = 0; let progressive_prefixes_rejected: i32 = 1;
    while (progressive_prefix < progressive_color_bytes.len) {
        let prefix_result: JpegDecodeResult = jpeg_decode(progressive_color_bytes.data[0..progressive_prefix]);
        if (prefix_result.valid != 0) { progressive_prefixes_rejected = 0; }
        jpeg_free(&prefix_result); progressive_prefix = progressive_prefix + 1;
    }
    failures = failures + asset_expect(progressive_prefixes_rejected == 1,
        "every truncated progressive JPEG prefix is rejected without a surface");
    let restart_jpeg_bytes: ArrayList[u8] = asset_hex_bytes("");
    let restart_jpeg: JpegDecodeResult = jpeg_decode(restart_jpeg_bytes.data[0..restart_jpeg_bytes.len]);
    failures = failures + asset_expect(restart_jpeg.valid == 1 && restart_jpeg.width == 16
        && restart_jpeg.height == 8 && restart_jpeg.surface.pixels.data[0] == 128
        && restart_jpeg.surface.pixels.data[15 * 4] == 128, "JPEG restart interval resets entropy and DC state");
    restart_jpeg_bytes.data[restart_jpeg_bytes.len - 5] = 210 as u8;
    let wrong_restart_jpeg: JpegDecodeResult = jpeg_decode(restart_jpeg_bytes.data[0..restart_jpeg_bytes.len]);
    failures = failures + asset_expect(wrong_restart_jpeg.valid == 0
        && wrong_restart_jpeg.error == JpegError.Entropy, "out-of-sequence JPEG restart marker is rejected");

    let raw: ArrayList[u8] = make[u8](12);
    push[u8](&raw, 255 as u8); push[u8](&raw, 64 as u8); push[u8](&raw, 0 as u8); push[u8](&raw, 128 as u8);
    push[u8](&raw, 10 as u8); push[u8](&raw, 20 as u8); push[u8](&raw, 30 as u8); push[u8](&raw, 255 as u8);
    push[u8](&raw, 91 as u8); push[u8](&raw, 92 as u8); push[u8](&raw, 93 as u8); push[u8](&raw, 94 as u8);
    let raw_decoded: RawPixelResult = raw_rgba8_decode(raw.data[0..raw.len], 2, 1, 12, 0);
    failures = failures + asset_expect(raw_decoded.valid == 1 && raw_decoded.error == AssetError.None
        && raw_decoded.source_bytes == 12 && raw_decoded.surface.width == 2 && raw_decoded.surface.height == 1,
        "raw RGBA8 dimensions and padded stride decode");
    failures = failures + asset_expect(raw_decoded.surface.pixels.data[0] == 128
        && raw_decoded.surface.pixels.data[1] == 32 && raw_decoded.surface.pixels.data[2] == 0
        && raw_decoded.surface.pixels.data[3] == 128 && raw_decoded.surface.pixels.data[4] == 10
        && raw_decoded.surface.pixels.data[5] == 20 && raw_decoded.surface.pixels.data[6] == 30
        && raw_decoded.surface.pixels.data[7] == 255, "straight RGBA8 becomes premultiplied renderer pixels");
    failures = failures + asset_expect(surface_checksum(&raw_decoded.surface) == 144691024,
        "raw RGBA8 decode matches deterministic golden");

    let invalid_premultiplied: ArrayList[u8] = make[u8](4);
    push[u8](&invalid_premultiplied, 200 as u8); push[u8](&invalid_premultiplied, 0 as u8);
    push[u8](&invalid_premultiplied, 0 as u8); push[u8](&invalid_premultiplied, 100 as u8);
    let invalid_raw: RawPixelResult = raw_rgba8_decode(
        invalid_premultiplied.data[0..invalid_premultiplied.len], 1, 1, 4, 1);
    failures = failures + asset_expect(invalid_raw.valid == 0
        && invalid_raw.error == AssetError.InvalidPremultipliedData && invalid_raw.error_offset == 0,
        "invalid premultiplied channels return typed error");
    let short_raw: RawPixelResult = raw_rgba8_decode(invalid_premultiplied.data[0..3], 1, 1, 4, 0);
    failures = failures + asset_expect(short_raw.valid == 0 && short_raw.error == AssetError.TruncatedData
        && short_raw.error_offset == 3, "truncated raw pixels return typed error and offset");
    let bad_stride: RawPixelResult = raw_rgba8_decode(invalid_premultiplied.data[0..4], 1, 1, 3, 0);
    failures = failures + asset_expect(bad_stride.valid == 0 && bad_stride.error == AssetError.InvalidStride,
        "undersized raw pixel stride is rejected");
    let trailing_raw: RawPixelResult = raw_rgba8_decode(raw.data[0..raw.len], 1, 1, 4, 0);
    failures = failures + asset_expect(trailing_raw.valid == 0 && trailing_raw.error == AssetError.TrailingData
        && trailing_raw.error_offset == 4, "trailing raw pixel bytes are rejected at the expected offset");
    let bad_dimensions: RawPixelResult = raw_rgba8_decode(invalid_premultiplied.data[0..4], 0, 1, 4, 0);
    failures = failures + asset_expect(bad_dimensions.valid == 0
        && bad_dimensions.error == AssetError.InvalidDimensions, "zero-sized raw pixel assets are rejected");
    let missing_raw: RawPixelResult = raw_rgba8_load_file("missing.rgba", 1, 1, 4, 0);
    failures = failures + asset_expect(missing_raw.valid == 0 && missing_raw.error == AssetError.Io,
        "missing raw pixel file returns typed IO error");

    failures = failures + asset_expect(asset_filter_case(0, 10, 20, 30, 15, 25, 35) == 1,
        "PNG None filter reconstructs scanlines");
    failures = failures + asset_expect(asset_filter_case(1, 10, 10, 10, 15, 10, 10) == 1,
        "PNG Sub filter reconstructs scanlines");
    failures = failures + asset_expect(asset_filter_case(2, 10, 20, 30, 5, 5, 5) == 1,
        "PNG Up filter reconstructs scanlines");
    failures = failures + asset_expect(asset_filter_case(3, 10, 15, 20, 10, 8, 8) == 1,
        "PNG Average filter reconstructs scanlines");
    failures = failures + asset_expect(asset_filter_case(4, 10, 10, 10, 5, 5, 5) == 1,
        "PNG Paeth filter reconstructs scanlines");

    let fixed_zlib: ArrayList[u8] = asset_hex_bytes("78014b4acc49cc4b4e4dd12d492dca4b2caad4cdc94ccf28d14d1a151e0cc20c8c4ccc2cac6cec1c9c5cdc3cbc7cfc028242c222a262e2129252e44901005755a29a");
    let fixed_inflate: PngInflateResult = png_zlib_inflate(fixed_zlib.data[0..fixed_zlib.len], 495);
    failures = failures + asset_expect(fixed_inflate.valid == 1 && len[u8](fixed_inflate.bytes) == 495
        && fixed_inflate.bytes.data[0] == 98 && fixed_inflate.bytes.data[7] == 100
