        wire_free(&malformed_requests);
        x11_clipboard_read_result_free(&malformed_result);
        x11_disconnect(&malformed_property_connection);
        let _malformed_property_closed: i64 = linux_close(
            malformed_property_pair.second);
    } else { failures = failures + 1; }

    let property_too_large_pair: LinuxFdPair = linux_socketpair_stream();
    if (property_too_large_pair.ok == 1) {
        let property_too_large_connection: X11NativeConnection =
            x11_clipboard_test_connection(property_too_large_pair.first, 1);
        let too_large_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let too_large_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 85, 3);
        let too_large_reply: WireBuffer = x11_clipboard_test_property_reply(
            4, 201, 8, 0, "xx");
        let too_large_cleanup: WireBuffer = x11_clipboard_test_owner_reply(6, 777);
        let _too_large_barrier_sent: i32 = x11_clipboard_test_send(
            property_too_large_pair.second, &too_large_barrier);
        let _too_large_notify_sent: i32 = x11_clipboard_test_send(
            property_too_large_pair.second, &too_large_notify);
        let _too_large_reply_sent: i32 = x11_clipboard_test_send(
            property_too_large_pair.second, &too_large_reply);
        let _too_large_cleanup_sent: i32 = x11_clipboard_test_send(
            property_too_large_pair.second, &too_large_cleanup);
        let too_large_result: X11ClipboardReadResult = x11_clipboard_read(
            &property_too_large_connection, 200,
            X11SelectionKind.Clipboard, 85, 100, 1);
        let too_large_requests: WireBuffer = linux_receive_exact(
            property_too_large_pair.second, 88, 100);
        failures = failures + x11_clipboard_expect(
            too_large_result.status == X11ClipboardStatus.TooLarge
            && too_large_result.valid == 0
            && property_too_large_connection.authenticated == 1
            && x11_clipboard_test_cleanup_requests(&too_large_requests) == 1,
