        x11_disconnect(&wrong_sequence_connection);
        let _wrong_sequence_closed: i64 = linux_close(wrong_sequence_pair.second);
    } else { failures = failures + 1; }

    let timeout_pair: LinuxFdPair = linux_socketpair_stream();
    if (timeout_pair.ok == 1) {
        let timeout_peer: i64 = x11_clipboard_test_fork();
        if (timeout_peer == 0) {
            let _child_connection_closed: i64 = linux_close(timeout_pair.first);
            let child_status: i32 = x11_clipboard_test_read_peer(timeout_pair.second, 0);
            let _child_peer_closed: i64 = linux_close(timeout_pair.second);
            x11_clipboard_test_child_exit(child_status);
            return child_status;
        }
        let _parent_peer_closed: i64 = linux_close(timeout_pair.second);
        let timeout_connection: X11NativeConnection = x11_clipboard_test_connection(
