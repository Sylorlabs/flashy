        x11_disconnect(&invalid_read_connection);
        let _invalid_read_closed: i64 = linux_close(invalid_read_pair.second);
    } else { failures = failures + 1; }

    if (failures != 0) { return 1; }
    _zag_println("x11_clipboard_test: ok");
    return 0;
}
