            && dequeued_untagged.selection_generation == 0
            && untagged_status == X11ClipboardStatus.OwnershipRejected
            && x11_decode_request(&untagged_response, 0).opcode == 25
            && x11_decode_request(&untagged_response, 44).opcode == 23
            && untagged_notify.valid == 1 && untagged_notify.property_atom == 0
            && untagged_connection.clipboard_selection.valid == 1
            && @strEq(text_buffer_view(
