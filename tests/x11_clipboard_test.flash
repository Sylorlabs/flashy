        x11_clipboard_read_result_free(&no_owner_result);
        x11_disconnect(&no_owner_connection);
        let _no_owner_peer_closed: i64 = linux_close(no_owner_pair.second);
    } else { failures = failures + 1; }

    let reject_pair: LinuxFdPair = linux_socketpair_stream();
    if (reject_pair.ok == 1) {
