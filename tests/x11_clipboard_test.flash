        let truncated_connection: X11NativeConnection = x11_clipboard_test_connection(
            truncated_pair.first, 1);
        let truncated_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let truncated_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 82, 3);
        let truncated_reply: WireBuffer = x11_clipboard_test_property_reply(
            4, 201, 8, 4, "part");
        let truncated_cleanup_barrier: WireBuffer = x11_clipboard_test_owner_reply(6, 777);
        let _truncated_barrier_sent: i32 = x11_clipboard_test_send(
