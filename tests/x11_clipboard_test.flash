            && consumed_timeout_event.kind == X11EventKind.SelectionRequest
            && consumed_timeout_event.selection_generation != 0
            && verified_barrier_status == X11ClipboardStatus.Ok
            && expired_notify_status == X11ClipboardStatus.Timeout
            && response_timeout_status == X11ClipboardStatus.Timeout
