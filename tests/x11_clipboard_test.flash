    let invalid_read_pair: LinuxFdPair = linux_socketpair_stream();
    if (invalid_read_pair.ok == 1) {
        let invalid_read_connection: X11NativeConnection = x11_clipboard_test_connection(
            invalid_read_pair.first, 1);
        let invalid_read_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let invalid_read_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 83, 3);
        let invalid_read_bytes: ArrayList[u8] = make[u8](2);
        push[u8](&invalid_read_bytes, 192 as u8); push[u8](&invalid_read_bytes, 128 as u8);
        let invalid_read_reply: WireBuffer = x11_clipboard_test_property_reply(
            4, 201, 8, 0, invalid_read_bytes.data[0..2]);
        let _invalid_read_barrier_sent: i32 = x11_clipboard_test_send(
            invalid_read_pair.second, &invalid_read_barrier);
        let _invalid_read_notify_sent: i32 = x11_clipboard_test_send(
            invalid_read_pair.second, &invalid_read_notify);
        let _invalid_read_reply_sent: i32 = x11_clipboard_test_send(
            invalid_read_pair.second, &invalid_read_reply);
