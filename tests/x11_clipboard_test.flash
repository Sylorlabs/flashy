            &read_connection, 200, X11SelectionKind.Clipboard, 77, 1000, 64);
        let read_peer_ok: i32 = x11_clipboard_test_wait_child(read_peer);
        failures = failures + x11_clipboard_expect(read_peer > 0 && read_peer_ok == 1
            && read_result.valid == 1 && read_result.status == X11ClipboardStatus.Ok
            && @strEq(text_buffer_view(&read_result.text), "world") == 1
            && read_connection.last_sent_sequence == 4
