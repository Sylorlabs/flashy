            && x11_clipboard_test_cleanup_requests(&truncated_requests) == 1
            && truncated_connection.last_sent_sequence == 6,
            "bytes-after truncation is deleted and fenced without partial clipboard text");
        wire_free(&truncated_requests); x11_clipboard_read_result_free(&truncated_result);
        x11_disconnect(&truncated_connection); let _truncated_closed: i64 = linux_close(truncated_pair.second);
    } else { failures = failures + 1; }

    let malformed_property_pair: LinuxFdPair = linux_socketpair_stream();
    if (malformed_property_pair.ok == 1) {
        let malformed_property_connection: X11NativeConnection =
            x11_clipboard_test_connection(malformed_property_pair.first, 1);
        let malformed_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let malformed_notify: WireBuffer = x11_clipboard_test_selection_notify(
