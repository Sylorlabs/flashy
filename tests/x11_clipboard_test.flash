            && no_owner_connection.authenticated == 1
            && x11_decode_request(&no_owner_request, 0).opcode == 23
            && linux_poll_readable(no_owner_pair.second, 0) == 0,
            "authoritative GetSelectionOwner None is NoSelection without conversion traffic");
