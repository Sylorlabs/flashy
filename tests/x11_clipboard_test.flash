        let timeout_peer_ok: i32 = x11_clipboard_test_wait_child(timeout_peer);
        failures = failures + x11_clipboard_expect(
            timeout_peer > 0 && timeout_peer_ok == 1
            && timeout_result.status == X11ClipboardStatus.Timeout
            && timeout_connection.authenticated == 0 && timeout_connection.fd == -1
            && timeout_connection.clipboard_selection.valid == 0
            && timeout_connection.clipboard_selection.text.bytes.cap == 0
