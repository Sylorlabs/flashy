        let type_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 80, 3);
        // When requested type UTF8_STRING does not match actual type STRING,
        // GetProperty returns no value tail and reports the full bytes-after.
        let type_reply: WireBuffer = x11_clipboard_test_property_reply(4, 31, 8, 6, "");
        let type_cleanup_barrier: WireBuffer = x11_clipboard_test_owner_reply(6, 777);
        let _type_barrier_sent: i32 = x11_clipboard_test_send(
            wrong_type_pair.second, &type_barrier);
        let _type_notify_sent: i32 = x11_clipboard_test_send(wrong_type_pair.second, &type_notify);
        let _type_reply_sent: i32 = x11_clipboard_test_send(wrong_type_pair.second, &type_reply);
        let _type_cleanup_sent: i32 = x11_clipboard_test_send(
            wrong_type_pair.second, &type_cleanup_barrier);
        let type_result: X11ClipboardReadResult = x11_clipboard_read(
            &wrong_type_connection, 200, X11SelectionKind.Clipboard, 80, 100, 64);
        let type_requests: WireBuffer = linux_receive_exact(wrong_type_pair.second, 88, 100);
        failures = failures + x11_clipboard_expect(
            type_result.status == X11ClipboardStatus.PropertyTypeMismatch
            && type_result.valid == 0 && wrong_type_connection.authenticated == 1
            && x11_clipboard_test_cleanup_requests(&type_requests) == 1
            && wrong_type_connection.last_sent_sequence == 6,
            "legacy property type is rejected, deleted, and fenced without reinterpretation");
        wire_free(&type_requests); x11_clipboard_read_result_free(&type_result);
        x11_disconnect(&wrong_type_connection); let _wrong_type_closed: i64 = linux_close(wrong_type_pair.second);
    } else { failures = failures + 1; }

    let wrong_format_pair: LinuxFdPair = linux_socketpair_stream();
    if (wrong_format_pair.ok == 1) {
        let wrong_format_connection: X11NativeConnection = x11_clipboard_test_connection(
            wrong_format_pair.first, 1);
        let format_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let format_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 81, 3);
        let format_data: ArrayList[u8] = make[u8](2);
        push[u8](&format_data, 65 as u8); push[u8](&format_data, 0 as u8);
        let format_reply: WireBuffer = x11_clipboard_test_property_reply(
            4, 201, 16, 0, format_data.data[0..2]);
        let format_cleanup_barrier: WireBuffer = x11_clipboard_test_owner_reply(6, 777);
        let _format_barrier_sent: i32 = x11_clipboard_test_send(
