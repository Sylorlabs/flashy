    let cleanup_error_pair: LinuxFdPair = linux_socketpair_stream();
    if (cleanup_error_pair.ok == 1) {
        let cleanup_error_connection: X11NativeConnection =
            x11_clipboard_test_connection(cleanup_error_pair.first, 1);
        let cleanup_error_barrier: WireBuffer = x11_clipboard_test_owner_reply(1, 777);
        let cleanup_error_notify: WireBuffer = x11_clipboard_test_selection_notify(
            200, 202, 201, 203, 86, 3);
        let cleanup_error_reply: WireBuffer = x11_clipboard_test_property_reply(
            4, 31, 8, 6, "");
        let cleanup_delete_error: WireBuffer = x11_clipboard_test_error(5, 19);
        let _cleanup_error_barrier_sent: i32 = x11_clipboard_test_send(
            cleanup_error_pair.second, &cleanup_error_barrier);
        let _cleanup_error_notify_sent: i32 = x11_clipboard_test_send(
            cleanup_error_pair.second, &cleanup_error_notify);
        let _cleanup_error_reply_sent: i32 = x11_clipboard_test_send(
            cleanup_error_pair.second, &cleanup_error_reply);
        let _cleanup_delete_error_sent: i32 = x11_clipboard_test_send(
            cleanup_error_pair.second, &cleanup_delete_error);
        let cleanup_error_result: X11ClipboardReadResult = x11_clipboard_read(
            &cleanup_error_connection, 200,
            X11SelectionKind.Clipboard, 86, 100, 64);
        let cleanup_error_requests: WireBuffer = linux_receive_exact(
            cleanup_error_pair.second, 88, 100);
        failures = failures + x11_clipboard_expect(
            cleanup_error_result.status == X11ClipboardStatus.TransportFailed
            && cleanup_error_result.valid == 0
            && x11_clipboard_test_cleanup_requests(&cleanup_error_requests) == 1
            && cleanup_error_connection.authenticated == 0
            && cleanup_error_connection.fd == -1,
            "DeleteProperty cleanup X error overrides parse status and retires transport");
        wire_free(&cleanup_error_requests);
        x11_clipboard_read_result_free(&cleanup_error_result);
        x11_disconnect(&cleanup_error_connection);
        let _cleanup_error_closed: i64 = linux_close(cleanup_error_pair.second);
