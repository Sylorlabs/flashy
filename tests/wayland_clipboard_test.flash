    let destroy_selected_b: WireBuffer = wayland_clipboard_destroy_source(
        &source_state, source_b);
    failures = failures + wayland_clipboard_expect(destroy_selected_b.error == 0
        && wayland_clipboard_destroy_source_commit(
            &source_state, source_b, 1) == 1
        && source_state.current_source.valid == 0,
        "destroying the active source clears local current identity only on commit");
    wire_free(&destroy_selected_b);
    wayland_clipboard_state_free(&source_state);

    let mismatched_commit_state: WaylandClipboardState =
        wayland_clipboard_state_new(3, 4, 5);
    let mismatched_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &mismatched_commit_state, 61);
    let mismatched_commit: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(
