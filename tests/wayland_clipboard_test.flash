    let cross_type_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_collision_state, colliding_offer_id);
    failures = failures + wayland_clipboard_expect(colliding_offer.valid == 1
        && cross_type_prepare.error != 0
        && source_collision_state.prepared_source.valid == 0
        && len[WaylandClipboardSource](source_collision_state.sources) == 0,
