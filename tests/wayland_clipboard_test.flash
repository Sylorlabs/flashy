    wire_free(&cross_type_prepare);
    wayland_clipboard_state_free(&source_collision_state);

    // Remote MIME strings are opaque bounded protocol strings. Unknown types,
    // duplicates, and preference-list overflow never gain authority and never
    // revoke the one exact Flashy text spelling.
    let offer_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let offer_a_id: t27 = wayland_clipboard_test_server_id(0);
    let offer_b_id: t27 = wayland_clipboard_test_server_id(1);
    let offer_c_id: t27 = wayland_clipboard_test_server_id(2);
    let offer_a_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, offer_a_id);
    let offer_a_frame: WaylandFrame = wayland_decode(&offer_a_event, 0);
    let offer_a_payload: t27 = wire_read_u32_le(&offer_a_event, 8);
    let offer_a_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &offer_a_event);
    let offer_a: WaylandClipboardIdentity = offer_a_dispatch.identity;
    wire_free(&offer_a_event);
    failures = failures + wayland_clipboard_expect(offer_a_frame.valid == 1
        && offer_a_frame.object_id == 4 && offer_a_frame.opcode == 0
        && offer_a_frame.size == 12 && offer_a_payload == offer_a_id
        && offer_a_dispatch.valid == 1
        && offer_a_dispatch.kind == WaylandClipboardEventKind.OfferIntroduced
        && offer_a.valid == 1
        && wayland_clipboard_identity_equal(offer_state.pending_offer, offer_a) == 1,
        "data_offer introduces one pending generation-tagged offer");

    let opaque_mime_event: WireBuffer = wayland_clipboard_offer_mime_event(
        offer_a_id, "application/x-weird; note=\"a / b\"");
    let opaque_mime_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &opaque_mime_event);
    wire_free(&opaque_mime_event);
    let offer_a_index: i32 = wayland_clipboard_identity_offer_index(
        &offer_state, offer_a);
    failures = failures + wayland_clipboard_expect(opaque_mime_dispatch.valid == 1
        && opaque_mime_dispatch.kind == WaylandClipboardEventKind.MimeOffered
        && offer_state.terminal == 0 && offer_a_index >= 0
        && len[WaylandClipboardMime](offer_state.offers.data[offer_a_index].mimes) == 1
        && offer_state.offers.data[offer_a_index].authoritative == 0,
        "quoted spaces and extra slashes remain opaque non-authoritative MIME data");
    let duplicate_mime_event: WireBuffer = wayland_clipboard_offer_mime_event(
        offer_a_id, "application/x-weird; note=\"a / b\"");
    let duplicate_mime_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &duplicate_mime_event);
    wire_free(&duplicate_mime_event);
    failures = failures + wayland_clipboard_expect(duplicate_mime_dispatch.valid == 1
        && offer_state.terminal == 0
        && len[WaylandClipboardMime](offer_state.offers.data[offer_a_index].mimes) == 1,
        "duplicate remote MIME offers are ignored without terminating the connection");
    let exact_mime_event: WireBuffer = wayland_clipboard_offer_mime_event(
        offer_a_id, wayland_clipboard_text_mime());
    let exact_mime_frame: WaylandFrame = wayland_decode(&exact_mime_event, 0);
    let exact_mime_value: WireString = wire_read_string(&exact_mime_event,
