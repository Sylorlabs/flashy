    let exact_mime_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &exact_mime_event);
    wire_free(&exact_mime_event);
    let select_offer_a_event: WireBuffer = wayland_clipboard_selection_event(
        4, offer_a_id);
    let select_offer_a_frame: WaylandFrame = wayland_decode(
        &select_offer_a_event, 0);
    let select_offer_a_payload: t27 = wire_read_u32_le(
        &select_offer_a_event, 8);
    let select_offer_a_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &select_offer_a_event);
    wire_free(&select_offer_a_event);
    failures = failures + wayland_clipboard_expect(exact_mime_frame.valid == 1
        && exact_mime_frame.object_id == offer_a_id && exact_mime_frame.opcode == 0
        && exact_mime_frame.size == 40 && exact_mime_literal == 1
        && exact_mime_dispatch.valid == 1
        && offer_state.offers.data[offer_a_index].authoritative == 1
        && select_offer_a_frame.valid == 1
        && select_offer_a_frame.object_id == 4
        && select_offer_a_frame.opcode == 5
        && select_offer_a_frame.size == 12 && select_offer_a_payload == offer_a_id
        && select_offer_a_dispatch.valid == 1
        && select_offer_a_dispatch.kind == WaylandClipboardEventKind.SelectionSet
        && select_offer_a_dispatch.authoritative == 1
        && wayland_clipboard_identity_equal(offer_state.current_offer, offer_a) == 1,
        "only exact text/plain;charset=utf-8 publishes selection text authority");

    let offer_b_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, offer_b_id);
    let offer_b_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &offer_b_event);
    let offer_b: WaylandClipboardIdentity = offer_b_dispatch.identity;
    wire_free(&offer_b_event);
    let offer_b_mime: WireBuffer = wayland_clipboard_offer_mime_event(
        offer_b_id, wayland_clipboard_text_mime());
    let _offer_b_mime_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &offer_b_mime);
    wire_free(&offer_b_mime);
    let select_offer_b_event: WireBuffer = wayland_clipboard_selection_event(
        4, offer_b_id);
    let select_offer_b_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &select_offer_b_event);
    wire_free(&select_offer_b_event);
    let retired_a: WaylandClipboardIdentity =
        wayland_clipboard_take_retired_offer(&offer_state);
    failures = failures + wayland_clipboard_expect(select_offer_b_dispatch.valid == 1
        && wayland_clipboard_identity_equal(select_offer_b_dispatch.replaced, offer_a) == 1
        && wayland_clipboard_identity_equal(retired_a, offer_a) == 1
        && wayland_clipboard_take_retired_offer(&offer_state).valid == 0,
        "selection replacement retires the prior offer exactly once through the FIFO");
    let destroy_a_request: WireBuffer = wayland_clipboard_destroy_offer(
        &offer_state, retired_a);
    let _destroy_a_commit: i32 = wayland_clipboard_destroy_offer_commit(
        &offer_state, retired_a, 1);
    wire_free(&destroy_a_request);

    let offer_c_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, offer_c_id);
    let offer_c_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &offer_c_event);
    let offer_c: WaylandClipboardIdentity = offer_c_dispatch.identity;
    wire_free(&offer_c_event);
    let focus_retired: i32 = wayland_clipboard_selection_focus_lost(&offer_state);
    let focus_first: WaylandClipboardIdentity =
        wayland_clipboard_take_retired_offer(&offer_state);
    let focus_second: WaylandClipboardIdentity =
        wayland_clipboard_take_retired_offer(&offer_state);
    failures = failures + wayland_clipboard_expect(focus_retired == 2
        && offer_state.pending_offer.valid == 0 && offer_state.current_offer.valid == 0
        && wayland_clipboard_identity_equal(focus_first, offer_c) == 1
        && wayland_clipboard_identity_equal(focus_second, offer_b) == 1
        && wayland_clipboard_take_retired_offer(&offer_state).valid == 0,
        "keyboard focus loss retires pending then current authority through a drainable FIFO");
    let destroy_c_request: WireBuffer = wayland_clipboard_destroy_offer(
        &offer_state, focus_first);
    let _destroy_c_commit: i32 = wayland_clipboard_destroy_offer_commit(
        &offer_state, focus_first, 1);
    wire_free(&destroy_c_request);
    let destroy_b_request: WireBuffer = wayland_clipboard_destroy_offer(
        &offer_state, focus_second);
    let _destroy_b_commit: i32 = wayland_clipboard_destroy_offer_commit(
        &offer_state, focus_second, 1);
    wire_free(&destroy_b_request);

    let reused_offer_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, offer_a_id);
    let reused_offer_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&offer_state, &reused_offer_event);
    let reused_offer: WaylandClipboardIdentity = reused_offer_dispatch.identity;
    wire_free(&reused_offer_event);
    let stale_destroy: WireBuffer = wayland_clipboard_destroy_offer(
        &offer_state, offer_a);
    let stale_receive: WaylandClipboardReceiveRequest =
        wayland_clipboard_begin_receive(&offer_state, offer_a);
    failures = failures + wayland_clipboard_expect(reused_offer.valid == 1
        && reused_offer.object_id == offer_a.object_id
        && reused_offer.generation != offer_a.generation
        && stale_destroy.error != 0 && stale_receive.valid == 0
        && stale_receive.error == WaylandClipboardError.StaleIdentity,
