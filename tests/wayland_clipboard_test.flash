@import("../src/core.flash")
@import("../src/wire.flash")
@import("../src/wayland.flash")
@import("../src/linux_transport.flash")
@import("../src/wayland_clipboard.flash")

// Deterministic fake-peer protocol/ownership proof only. This suite makes no
// live-compositor, desktop-integration, or hardware execution claim.

fn wayland_clipboard_expect(ok: i32, message: []u8) i32 {
    if (ok == 0) { _zag_print("FAIL "); _zag_println(message); return 1; }
    return 0;
}

fn wayland_clipboard_test_process(state: *WaylandClipboardState,
    frame: *WireBuffer) WaylandClipboardDispatch {
    return wayland_clipboard_process_frame(state, frame, 0 - 1, 0, 1);
}

fn wayland_clipboard_test_server_id(index: t27) t27 {
    return wayland_server_new_id_min() + index;
}

fn wayland_clipboard_test_native_wire(
    input: *LinuxByteBuffer) WireBuffer {
    let out: WireBuffer = wire_new(input.*.len);
    let i: i32 = 0;
    while (i < input.*.len) {
        wire_push_u8(&out, linux_buffer_byte(input, i) as t27); i = i + 1;
    }
    return out;
}

fn wayland_clipboard_test_wire_prefix(input: *WireBuffer,
    count: i32) WireBuffer {
    let out: WireBuffer = wire_new(count);
    if (count < 0 || count > len[u8](input.*.bytes)) {
        out.error = 1; return out;
    }
    let i: i32 = 0;
    while (i < count) {
        wire_push_u8(&out, get[u8](input.*.bytes, i) as t27); i = i + 1;
    }
    return out;
}

fn wayland_clipboard_test_linux_bytes(value: []u8) LinuxByteBuffer {
    let out: LinuxByteBuffer = linux_buffer_new(value.len);
    let i: i32 = 0;
    while (i < value.len) {
        linux_buffer_set_byte(&out, i, value[i] as t9); i = i + 1;
    }
    return out;
}

fn wayland_clipboard_test_text_equal(
    result: *WaylandClipboardTextResult, expected: []u8) i32 {
    if (result.*.valid == 0 || len[u8](result.*.bytes) != expected.len) { return 0; }
    let i: i32 = 0;
    while (i < expected.len) {
        if (get[u8](result.*.bytes, i) != expected[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Test-only malicious sender. Production uses the frozen exact-write adapter;
// this fixture attaches two descriptors so the runtime and protocol can prove
// fail-closed cardinality and close ownership.
fn wayland_clipboard_test_send_many(socket_fd: i64, input: *WireBuffer,
    fds: *ArrayList[i64]) i64 {
    let packed: LinuxByteBuffer = linux_pack_wire(input);
    let count: i32 = len[i64](fds.*);
    if (socket_fd < 0 || packed.len < 1 || count < 1 || count > 2) {
        linux_buffer_free(&packed); return 0 - 22;
    }
    let iovec: LinuxByteBuffer = linux_buffer_new(16);
    linux_buffer_set_u64(&iovec, 0, packed.words.data as i64);
    linux_buffer_set_u64(&iovec, 8, packed.len as i64);
    let cmsg_len: i64 = 16 + (count as i64) * 4;
    let control_len: i32 = linux_cmsg_align(cmsg_len) as i32;
    let control: LinuxByteBuffer = linux_buffer_new(control_len);
    linux_buffer_set_u64(&control, 0, cmsg_len);
    linux_buffer_set_u32(&control, 8, 1); linux_buffer_set_u32(&control, 12, 1);
    let fd_i: i32 = 0;
    while (fd_i < count) {
        linux_buffer_set_u32(&control, 16 + fd_i * 4,
            get[i64](fds.*, fd_i)); fd_i = fd_i + 1;
    }
    control.len = control_len;
    let message: LinuxByteBuffer = linux_buffer_new(56);
    linux_buffer_zero_storage(&message);
    linux_buffer_set_u64(&message, 16, iovec.words.data as i64);
    linux_buffer_set_u64(&message, 24, 1);
    linux_buffer_set_u64(&message, 32, control.words.data as i64);
    linux_buffer_set_u64(&message, 40, control_len as i64);
    message.len = 56;
    let sent: i64 = _zag_raw_syscall(linux_sys_sendmsg(), socket_fd,
        message.words.data as i64, 0, 0, 0, 0);
    linux_buffer_free(&message); linux_buffer_free(&control);
    linux_buffer_free(&iovec); linux_buffer_free(&packed);
    return sent;
}

fn wayland_clipboard_test_ready_source(state: *WaylandClipboardState,
    object_id: t27, selected: i32) WaylandClipboardIdentity {
    let create: WireBuffer = wayland_clipboard_prepare_source(state, object_id);
    if (create.error != 0) { wire_free(&create); return wayland_clipboard_bad_identity(); }
    let identity: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(state, object_id, 1);
    wire_free(&create);
    if (identity.valid == 0) { return identity; }
    let offer: WireBuffer = wayland_clipboard_source_offer(
        state, identity, wayland_clipboard_text_mime());
    if (offer.error != 0 || wayland_clipboard_source_offer_commit(
        state, identity, 1) == 0) {
        wire_free(&offer); return wayland_clipboard_bad_identity();
    }
    wire_free(&offer);
    if (selected != 0) {
        let select: WireBuffer = wayland_clipboard_set_source_selection(
            state, identity, 0);
        if (select.error != 0 || wayland_clipboard_set_source_selection_commit(
            state, identity, 1) == 0) {
            wire_free(&select); return wayland_clipboard_bad_identity();
        }
        wire_free(&select);
    }
    return identity;
}

fn main() i32 {
    let failures: i32 = 0;

    let empty: WaylandClipboardState = wayland_clipboard_empty_state();
    wayland_clipboard_state_free(&empty);
    failures = failures + wayland_clipboard_expect(empty.valid == 0,
        "empty clipboard state is safe to free");

    let client_min_frame: WireBuffer = wayland_new_id_request(
        3, 0, wayland_client_new_id_min());
    let client_max_frame: WireBuffer = wayland_new_id_request(
        3, 0, wayland_client_new_id_max());
    let client_reserved_one: WireBuffer = wayland_new_id_request(3, 0, 1);
    let client_cross_role: WireBuffer = wayland_new_id_request(
        3, 0, wayland_server_new_id_min());
    let server_min_frame: WireBuffer = wayland_server_new_id_event(
        4, 0, wayland_server_new_id_min());
    let server_max_frame: WireBuffer = wayland_server_new_id_event(
        4, 0, wayland_server_new_id_max());
    let server_cross_role: WireBuffer = wayland_server_new_id_event(
        4, 0, wayland_client_new_id_max());
    let server_overflow: WireBuffer = wayland_server_new_id_event(
        4, 0, wayland_server_new_id_max() + 1);
    failures = failures + wayland_clipboard_expect(
        wayland_client_new_id_valid(1) == 0
        && wayland_client_new_id_valid(wayland_client_new_id_min()) == 1
        && wayland_client_new_id_valid(wayland_client_new_id_max()) == 1
        && wayland_client_new_id_valid(wayland_server_new_id_min()) == 0
        && client_min_frame.error == 0 && client_max_frame.error == 0
        && client_reserved_one.error != 0 && client_cross_role.error != 0
        && wire_read_u32_le(&client_min_frame, 8) == 2
        && wire_read_u32_le(&client_max_frame, 8) == 4278190079,
        "client-created new_id accepts exactly 2 through 0xfeffffff");
    failures = failures + wayland_clipboard_expect(
        wayland_server_new_id_valid(wayland_client_new_id_max()) == 0
        && wayland_server_new_id_valid(wayland_server_new_id_min()) == 1
        && wayland_server_new_id_valid(wayland_server_new_id_max()) == 1
        && wayland_server_new_id_valid(wayland_server_new_id_max() + 1) == 0
        && server_min_frame.error == 0 && server_max_frame.error == 0
        && server_cross_role.error != 0 && server_overflow.error != 0
        && wire_read_u32_le(&server_min_frame, 8) == 4278190080
        && wire_read_u32_le(&server_max_frame, 8) == 4294967295,
        "server-created new_id accepts exactly 0xff000000 through uint32 max");
    wire_free(&client_min_frame); wire_free(&client_max_frame);
    wire_free(&client_reserved_one); wire_free(&client_cross_role);
    wire_free(&server_min_frame); wire_free(&server_max_frame);
    wire_free(&server_cross_role); wire_free(&server_overflow);

    let sync_client_min: WireBuffer = wayland_display_sync(
        wayland_client_new_id_min());
    let registry_client_max: WireBuffer = wayland_display_get_registry(
        wayland_client_new_id_max());
    let sync_server_id: WireBuffer = wayland_display_sync(
        wayland_server_new_id_min());
    let registry_reserved_id: WireBuffer = wayland_display_get_registry(1);
    let bind_server_id: WireBuffer = wayland_registry_bind(
        2, 9, "wl_compositor", 1, wayland_server_new_id_min());
    let seat_server_id: WireBuffer = wayland_seat_get_keyboard(
        5, wayland_server_new_id_min());
    let xdg_server_id: WireBuffer = wayland_xdg_get_surface(
        6, wayland_server_new_id_min(), 7);
    let pool_server_id: WireBuffer = wayland_shm_create_pool(
        8, wayland_server_new_id_min(), 729);
    let buffer_server_id: WireBuffer = wayland_shm_pool_create_buffer(
        9, wayland_server_new_id_min(), 3, 3, 12);
    failures = failures + wayland_clipboard_expect(sync_client_min.error == 0
        && registry_client_max.error == 0
        && wire_read_u32_le(&sync_client_min, 8) == wayland_client_new_id_min()
        && wire_read_u32_le(&registry_client_max, 8)
            == wayland_client_new_id_max()
        && sync_server_id.error != 0 && registry_reserved_id.error != 0
        && bind_server_id.error != 0 && seat_server_id.error != 0
        && xdg_server_id.error != 0 && pool_server_id.error != 0
        && buffer_server_id.error != 0,
        "every shared client new_id encoder rejects reserved/server-owned IDs");
    wire_free(&sync_client_min); wire_free(&registry_client_max);
    wire_free(&sync_server_id); wire_free(&registry_reserved_id);
    wire_free(&bind_server_id); wire_free(&seat_server_id);
    wire_free(&xdg_server_id); wire_free(&pool_server_id);
    wire_free(&buffer_server_id);

    let client_role_state: WaylandClipboardState = wayland_clipboard_state_new(
        wayland_client_new_id_min(), wayland_client_new_id_min() + 1,
        wayland_client_new_id_max());
    let reserved_manager_state: WaylandClipboardState =
        wayland_clipboard_state_new(1, 3, 4);
    let server_device_state: WaylandClipboardState =
        wayland_clipboard_state_new(2, wayland_server_new_id_min(), 4);
    let server_seat_state: WaylandClipboardState =
        wayland_clipboard_state_new(2, 3, wayland_server_new_id_max());
    failures = failures + wayland_clipboard_expect(client_role_state.valid == 1
        && reserved_manager_state.valid == 0
        && reserved_manager_state.error == WaylandClipboardError.InvalidIdentity
        && server_device_state.valid == 0
        && server_device_state.error == WaylandClipboardError.InvalidIdentity
        && server_seat_state.valid == 0
        && server_seat_state.error == WaylandClipboardError.InvalidIdentity,
        "clipboard state accepts only client-created manager/device/seat IDs");
    wayland_clipboard_state_free(&client_role_state);
    wayland_clipboard_state_free(&reserved_manager_state);
    wayland_clipboard_state_free(&server_device_state);
    wayland_clipboard_state_free(&server_seat_state);

    let source_role_state: WaylandClipboardState =
        wayland_clipboard_state_new(3, 4, 5);
    let source_reserved_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_role_state, 1);
    let source_server_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_role_state, wayland_server_new_id_min());
    let source_max_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_role_state, wayland_client_new_id_max());
    let source_max_reserved: WaylandClipboardIdentity =
        source_role_state.prepared_source;
    let source_max_abort: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(&source_role_state,
            wayland_client_new_id_max(), 0);
    failures = failures + wayland_clipboard_expect(
        source_reserved_prepare.error != 0 && source_server_prepare.error != 0
        && source_max_prepare.error == 0 && source_max_reserved.valid == 1
        && source_max_reserved.object_id == wayland_client_new_id_max()
        && source_max_abort.valid == 0
        && source_role_state.prepared_source.valid == 0
        && len[WaylandClipboardSource](source_role_state.sources) == 0,
        "source reservation enforces client new_id bounds before transport");
    wire_free(&source_reserved_prepare); wire_free(&source_server_prepare);
    wire_free(&source_max_prepare);
    wayland_clipboard_state_free(&source_role_state);

    let invalid_offer_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, wayland_client_new_id_max());
    let raw_client_range_offer: WireBuffer = wayland_u32_request(
        4, 0, wayland_client_new_id_max());
    let invalid_offer_state: WaylandClipboardState =
        wayland_clipboard_state_new(3, 4, 5);
    let invalid_offer_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&invalid_offer_state,
            &raw_client_range_offer);
    failures = failures + wayland_clipboard_expect(invalid_offer_event.error != 0
        && invalid_offer_dispatch.valid == 0
        && invalid_offer_dispatch.error == WaylandClipboardError.InvalidIdentity
        && invalid_offer_state.terminal == 1
        && len[WaylandClipboardOffer](invalid_offer_state.offers) == 0,
        "incoming data_offer rejects a client-range server new_id before authority");
    wire_free(&invalid_offer_event); wire_free(&raw_client_range_offer);
    wayland_clipboard_state_free(&invalid_offer_state);

    let server_max_offer_state: WaylandClipboardState =
        wayland_clipboard_state_new(3, 4, 5);
    let server_max_offer_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, wayland_server_new_id_max());
    let server_max_offer_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&server_max_offer_state,
            &server_max_offer_event);
    failures = failures + wayland_clipboard_expect(
        server_max_offer_event.error == 0 && server_max_offer_dispatch.valid == 1
        && server_max_offer_dispatch.identity.object_id
            == wayland_server_new_id_max()
        && server_max_offer_state.terminal == 0,
        "incoming data_offer accepts the exact server-created upper bound");
    wire_free(&server_max_offer_event);
    wayland_clipboard_state_free(&server_max_offer_state);

    // Outbound v1 schemas are literal wire contracts. Serial presence belongs
    // to the caller; every uint32 value, including wrap-through zero, is data.
    let create_source: WireBuffer =
        wayland_clipboard_manager_create_source_request(3, 27);
    let create_source_frame: WaylandFrame = wayland_decode(&create_source, 0);
    failures = failures + wayland_clipboard_expect(create_source.error == 0
        && create_source_frame.valid == 1 && create_source_frame.object_id == 3
        && create_source_frame.opcode == 0 && create_source_frame.size == 12
        && get[u8](create_source.bytes, 0) == 3
        && get[u8](create_source.bytes, 4) == 0
        && get[u8](create_source.bytes, 6) == 12
        && wire_read_u32_le(&create_source, 8) == 27,
        "create_data_source is an exact opcode-0 new-id frame");
    wire_free(&create_source);
    let create_source_reserved: WireBuffer =
        wayland_clipboard_manager_create_source_request(3, 1);
    let create_source_cross_role: WireBuffer =
        wayland_clipboard_manager_create_source_request(
            3, wayland_server_new_id_min());
    failures = failures + wayland_clipboard_expect(
        create_source_reserved.error != 0 && create_source_cross_role.error != 0,
        "create_data_source rejects reserved and server-owned ID ranges");
    wire_free(&create_source_reserved); wire_free(&create_source_cross_role);

    let get_device: WireBuffer =
        wayland_clipboard_manager_get_device_request(3, 4, 5);
    let get_device_frame: WaylandFrame = wayland_decode(&get_device, 0);
    failures = failures + wayland_clipboard_expect(get_device.error == 0
        && get_device_frame.valid == 1 && get_device_frame.object_id == 3
        && get_device_frame.opcode == 1 && get_device_frame.size == 16
        && wire_read_u32_le(&get_device, 8) == 4
        && wire_read_u32_le(&get_device, 12) == 5,
        "get_data_device carries exact new-id then seat object payload");
    wire_free(&get_device);
    let get_device_cross_role: WireBuffer =
        wayland_clipboard_manager_get_device_request(
            3, wayland_server_new_id_min(), 5);
    failures = failures + wayland_clipboard_expect(
        get_device_cross_role.error != 0,
        "get_data_device rejects a server-owned new-id while retaining seat references");
    wire_free(&get_device_cross_role);

    let selection_zero: WireBuffer =
        wayland_clipboard_device_set_selection_request(4, 27, 0);
    let selection_zero_frame: WaylandFrame = wayland_decode(&selection_zero, 0);
    failures = failures + wayland_clipboard_expect(selection_zero.error == 0
        && selection_zero_frame.valid == 1 && selection_zero_frame.object_id == 4
        && selection_zero_frame.opcode == 1 && selection_zero_frame.size == 16
        && get[u8](selection_zero.bytes, 4) == 1
        && get[u8](selection_zero.bytes, 6) == 16
        && wire_read_u32_le(&selection_zero, 8) == 27
        && wire_read_u32_le(&selection_zero, 12) == 0,
        "set_selection accepts serial zero and emits exact literal bytes");
    wire_free(&selection_zero);
    let selection_max: WireBuffer =
        wayland_clipboard_device_set_selection_request(4, 27, 4294967295);
    failures = failures + wayland_clipboard_expect(selection_max.error == 0
        && wire_read_u32_le(&selection_max, 12) == 4294967295,
        "set_selection preserves maximum uint32 serial");
    wire_free(&selection_max);
    let selection_overflow: WireBuffer =
        wayland_clipboard_device_set_selection_request(4, 27, 4294967296);
    failures = failures + wayland_clipboard_expect(selection_overflow.error != 0,
        "set_selection rejects values outside uint32 without truncation");
    wire_free(&selection_overflow);

    let offer_request: WireBuffer = wayland_clipboard_source_offer_request(
        27, wayland_clipboard_text_mime());
    let offer_request_frame: WaylandFrame = wayland_decode(&offer_request, 0);
    let offer_request_value: WireString = wire_read_string(&offer_request,
        offer_request_frame.payload_offset, offer_request_frame.size as i32);
    failures = failures + wayland_clipboard_expect(offer_request.error == 0
        && offer_request_frame.valid == 1 && offer_request_frame.object_id == 27
        && offer_request_frame.opcode == 0
        && wire_read_u32_le(&offer_request, 8) == 25
        && get[u8](offer_request.bytes, 12) == 't'
        && get[u8](offer_request.bytes, 36) == 0
        && offer_request_value.valid == 1
        && @strEq(offer_request_value.value,
            "text/plain;charset=utf-8") != 0,
        "data_source.offer uses an exact NUL-terminated UTF-8 MIME string");
    wire_free(&offer_request);

    let source_destroy_wire: WireBuffer =
        wayland_clipboard_source_destroy_request(27);
    let source_destroy_frame: WaylandFrame = wayland_decode(&source_destroy_wire, 0);
    failures = failures + wayland_clipboard_expect(source_destroy_frame.valid == 1
        && source_destroy_frame.object_id == 27
        && source_destroy_frame.opcode == 1 && source_destroy_frame.size == 8,
        "data_source.destroy is the exact v1 opcode-1 empty frame");
    wire_free(&source_destroy_wire);

    let clear_selection_wire: WireBuffer =
        wayland_clipboard_device_set_selection_request(4, 0, 0);
    let clear_selection_frame: WaylandFrame = wayland_decode(&clear_selection_wire, 0);
    failures = failures + wayland_clipboard_expect(clear_selection_frame.valid == 1
        && clear_selection_frame.opcode == 1 && clear_selection_frame.size == 16
        && wire_read_u32_le(&clear_selection_wire, 8) == 0
        && wire_read_u32_le(&clear_selection_wire, 12) == 0,
        "null set_selection emits object zero without inventing serial presence");
    wire_free(&clear_selection_wire);

    let outbound_offer_id: t27 = wayland_clipboard_test_server_id(0);
    let receive_request_wire: WireBuffer = wayland_clipboard_offer_receive_request(
        outbound_offer_id, wayland_clipboard_text_mime());
    let receive_request_frame: WaylandFrame = wayland_decode(&receive_request_wire, 0);
    let receive_request_value: WireString = wire_read_string(&receive_request_wire,
        receive_request_frame.payload_offset, receive_request_frame.size as i32);
    failures = failures + wayland_clipboard_expect(receive_request_wire.error == 0
        && receive_request_frame.valid == 1
        && receive_request_frame.object_id == outbound_offer_id
        && receive_request_frame.opcode == 1
        && receive_request_frame.size == 40
        && receive_request_value.valid == 1
        && @strEq(receive_request_value.value,
            "text/plain;charset=utf-8") != 0,
        "data_offer.receive keeps its fd ancillary and its frame exactly string-sized");
    wire_free(&receive_request_wire);
    let destroy_offer_wire: WireBuffer = wayland_clipboard_offer_destroy_request(
        outbound_offer_id);
    let destroy_offer_frame: WaylandFrame = wayland_decode(&destroy_offer_wire, 0);
    failures = failures + wayland_clipboard_expect(destroy_offer_frame.valid == 1
        && destroy_offer_frame.object_id == outbound_offer_id
        && destroy_offer_frame.opcode == 2 && destroy_offer_frame.size == 8,
        "data_offer.destroy is the exact v1 opcode-2 destructor");
    wire_free(&destroy_offer_wire);

    // Prepared-but-unsent requests cannot publish authority. Every stateful
    // operation commits only after an owning transport reports full success.
    let source_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let create_prepared: WireBuffer = wayland_clipboard_prepare_source(
        &source_state, 27);
    let provisional_source: WaylandClipboardIdentity = source_state.prepared_source;
    let provisional_index: i32 = wayland_clipboard_source_slot_index(
        &source_state, 27);
    let overlapping_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_state, 28);
    let wrong_prepare_commit: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(&source_state, 28, 0);
    failures = failures + wayland_clipboard_expect(create_prepared.error == 0
        && provisional_source.valid == 1 && provisional_index >= 0
        && len[WaylandClipboardSource](source_state.sources) == 1
        && source_state.sources.data[provisional_index].committed == 0
        && wayland_clipboard_source_index(&source_state, 27) < 0
        && overlapping_prepare.error != 0 && wrong_prepare_commit.valid == 0
        && wayland_clipboard_identity_equal(
            source_state.prepared_source, provisional_source) == 1,
        "prepare reserves one non-authoritative slot and rejects overlap/wrong commit");
    wire_free(&overlapping_prepare);
    let aborted_source: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(&source_state, 27, 0);
    failures = failures + wayland_clipboard_expect(aborted_source.valid == 0
        && source_state.prepared_source.valid == 0
        && len[WaylandClipboardSource](source_state.sources) == 0,
        "sent=0 abort removes the exact provisional source slot");
    wire_free(&create_prepared);

    let create_committed: WireBuffer = wayland_clipboard_prepare_source(
        &source_state, 27);
    let source_a: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(&source_state, 27, 1);
    wire_free(&create_committed);
    let source_collision_prepare: WireBuffer = wayland_clipboard_prepare_source(
        &source_state, 27);
    failures = failures + wayland_clipboard_expect(source_a.valid == 1
        && source_a.generation > 0
        && source_a.generation != provisional_source.generation
        && len[WaylandClipboardSource](source_state.sources) == 1
        && wayland_clipboard_source_index(&source_state, 27) >= 0
        && source_collision_prepare.error != 0,
        "sent=1 infallibly flips the reserved identity and blocks object collision");
    wire_free(&source_collision_prepare);

    let source_a_offer: WireBuffer = wayland_clipboard_source_offer(
        &source_state, source_a, wayland_clipboard_text_mime());
    let source_a_index: i32 = wayland_clipboard_identity_source_index(
        &source_state, source_a);
    failures = failures + wayland_clipboard_expect(source_a_offer.error == 0
        && source_state.sources.data[source_a_index].authoritative_offered == 0
        && wayland_clipboard_source_offer_commit(&source_state, source_a, 0) == 0
        && source_state.sources.data[source_a_index].authoritative_offered == 0
        && wayland_clipboard_source_offer_commit(&source_state, source_a, 1) == 1
        && source_state.sources.data[source_a_index].authoritative_offered == 1,
        "source MIME authority appears only after exact send commit");
    wire_free(&source_a_offer);

    let select_a: WireBuffer = wayland_clipboard_set_source_selection(
        &source_state, source_a, 0);
    failures = failures + wayland_clipboard_expect(select_a.error == 0
        && source_state.sources.data[source_a_index].used == 0
        && wayland_clipboard_set_source_selection_commit(
            &source_state, source_a, 0) == 0
        && source_state.sources.data[source_a_index].used == 0
        && wayland_clipboard_set_source_selection_commit(
            &source_state, source_a, 1) == 1
        && source_state.sources.data[source_a_index].used == 1
        && source_state.sources.data[source_a_index].selected == 1,
