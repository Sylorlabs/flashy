    wayland_clipboard_state_free(&stale_state);

    // selection(NULL) can retire both a pending candidate and current
    // authority. Every identity remains available even though dispatch.replaced
    // is a single convenience field.
    let null_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let null_current_id: t27 = wayland_clipboard_test_server_id(0);
    let null_pending_id: t27 = wayland_clipboard_test_server_id(1);
    let null_current_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, null_current_id);
    let null_current_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&null_state, &null_current_event);
    wire_free(&null_current_event);
    let null_current_mime: WireBuffer = wayland_clipboard_offer_mime_event(
        null_current_id, wayland_clipboard_text_mime());
    let _null_current_mime_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&null_state, &null_current_mime);
    wire_free(&null_current_mime);
    let null_current_select: WireBuffer = wayland_clipboard_selection_event(
        4, null_current_id);
    let _null_current_select_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&null_state, &null_current_select);
    wire_free(&null_current_select);
    let null_pending_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, null_pending_id);
    let null_pending_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&null_state, &null_pending_event);
    wire_free(&null_pending_event);
    let null_event: WireBuffer = wayland_clipboard_selection_event(4, 0);
    let null_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&null_state, &null_event);
    wire_free(&null_event);
    let null_pending_retired: WaylandClipboardIdentity =
        wayland_clipboard_take_retired_offer(&null_state);
    failures = failures + wayland_clipboard_expect(null_dispatch.valid == 1
        && null_dispatch.kind == WaylandClipboardEventKind.SelectionCleared
        && wayland_clipboard_identity_equal(
            null_dispatch.replaced, null_current_dispatch.identity) == 1
        && wayland_clipboard_identity_equal(
            null_pending_retired, null_pending_dispatch.identity) == 1,
