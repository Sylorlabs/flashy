    wire_free(&select_a);
    let reuse_a: WireBuffer = wayland_clipboard_set_source_selection(
        &source_state, source_a, 1);
    failures = failures + wayland_clipboard_expect(reuse_a.error != 0,
        "one-shot data source reuse is rejected even while still selected");
    wire_free(&reuse_a);

    let create_b: WireBuffer = wayland_clipboard_prepare_source(
        &source_state, 28);
    let source_b: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(&source_state, 28, 1);
    wire_free(&create_b);
    let source_b_offer: WireBuffer = wayland_clipboard_source_offer(
        &source_state, source_b, wayland_clipboard_text_mime());
    let _source_b_offer_commit: i32 = wayland_clipboard_source_offer_commit(
        &source_state, source_b, 1);
    wire_free(&source_b_offer);
    let select_b: WireBuffer = wayland_clipboard_set_source_selection(
        &source_state, source_b, 4294967295);
    let _select_b_commit: i32 = wayland_clipboard_set_source_selection_commit(
        &source_state, source_b, 1);
    wire_free(&select_b);
    let source_a_after: i32 = wayland_clipboard_identity_source_index(
        &source_state, source_a);
    failures = failures + wayland_clipboard_expect(source_a_after >= 0
        && source_state.sources.data[source_a_after].selected == 0
        && source_state.sources.data[source_a_after].used == 1
        && wayland_clipboard_identity_equal(source_state.current_source, source_b) == 1,
        "replacement clears selection but never resets the prior source used bit");

    let reuse_replaced_a: WireBuffer = wayland_clipboard_set_source_selection(
        &source_state, source_a, 2);
    let destroy_replaced_a: WireBuffer = wayland_clipboard_destroy_source(
        &source_state, source_a);
    failures = failures + wayland_clipboard_expect(reuse_replaced_a.error != 0
        && destroy_replaced_a.error == 0
        && wayland_clipboard_destroy_source_commit(
            &source_state, source_a, 1) == 1
        && wayland_clipboard_identity_source_index(&source_state, source_a) < 0,
