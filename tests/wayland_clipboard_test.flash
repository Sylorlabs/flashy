    wire_free(&stale_destroy);
    let _abort_stale_receive: i32 =
        wayland_clipboard_receive_request_abort(&stale_receive);
    wayland_clipboard_state_free(&offer_state);

    let late_mime_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let late_offer_id: t27 = wayland_clipboard_test_server_id(0);
    let late_offer_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, late_offer_id);
    let late_offer_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&late_mime_state, &late_offer_event);
    wire_free(&late_offer_event);
    let late_i: i32 = 0;
    while (late_i < 27) {
        let unknown: ArrayList[u8] = make[u8](1);
        push[u8](&unknown, ('A' + late_i) as u8);
        let unknown_event: WireBuffer = wayland_clipboard_offer_mime_event(
            late_offer_id, unknown.data[0..len[u8](unknown)]);
        let unknown_dispatch: WaylandClipboardDispatch =
            wayland_clipboard_test_process(&late_mime_state, &unknown_event);
        failures = failures + wayland_clipboard_expect(unknown_dispatch.valid == 1
            && late_mime_state.terminal == 0,
            "bounded unknown MIME preference is nonterminal");
        wire_free(&unknown_event); free[u8](&unknown); late_i = late_i + 1;
    }
    let late_exact_event: WireBuffer = wayland_clipboard_offer_mime_event(
        late_offer_id, wayland_clipboard_text_mime());
    let late_exact_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&late_mime_state, &late_exact_event);
    wire_free(&late_exact_event);
    let late_offer_index: i32 = wayland_clipboard_identity_offer_index(
        &late_mime_state, late_offer_dispatch.identity);
    let late_select_event: WireBuffer = wayland_clipboard_selection_event(
        4, late_offer_id);
    let late_select_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&late_mime_state, &late_select_event);
    wire_free(&late_select_event);
    failures = failures + wayland_clipboard_expect(late_exact_dispatch.valid == 1
        && late_offer_index >= 0
        && len[WaylandClipboardMime](late_mime_state.offers.data[late_offer_index].mimes) == 27
        && late_mime_state.offers.data[late_offer_index].authoritative == 1
        && late_select_dispatch.valid == 1 && late_select_dispatch.authoritative == 1,
        "exact UTF-8 MIME grants authority even after 27 retained unknown types");
    wayland_clipboard_state_free(&late_mime_state);

    let early_mime_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let early_offer_id: t27 = wayland_clipboard_test_server_id(0);
    let early_offer_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, early_offer_id);
    let early_offer_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&early_mime_state, &early_offer_event);
    wire_free(&early_offer_event);
    let early_exact_event: WireBuffer = wayland_clipboard_offer_mime_event(
        early_offer_id, wayland_clipboard_text_mime());
    let _early_exact_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&early_mime_state, &early_exact_event);
    wire_free(&early_exact_event);
    let early_i: i32 = 0;
    while (early_i < 29) {
        let unknown: ArrayList[u8] = make[u8](1);
        push[u8](&unknown, ('a' + early_i) as u8);
        let unknown_event: WireBuffer = wayland_clipboard_offer_mime_event(
            early_offer_id, unknown.data[0..len[u8](unknown)]);
        let unknown_dispatch: WaylandClipboardDispatch =
            wayland_clipboard_test_process(&early_mime_state, &unknown_event);
        failures = failures + wayland_clipboard_expect(unknown_dispatch.valid == 1
