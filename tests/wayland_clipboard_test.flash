    wayland_clipboard_state_free(&early_mime_state);

    // Selection must name the immediately introduced pending offer. An older
    // object ID can never acquire authority after a newer data_offer event.
    let stale_state: WaylandClipboardState = wayland_clipboard_state_new(3, 4, 5);
    let stale_a_id: t27 = wayland_clipboard_test_server_id(0);
    let stale_b_id: t27 = wayland_clipboard_test_server_id(1);
    let stale_a_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, stale_a_id);
    let stale_a_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&stale_state, &stale_a_event);
    wire_free(&stale_a_event);
    let stale_b_event: WireBuffer = wayland_clipboard_data_offer_event(
        4, stale_b_id);
    let stale_b_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&stale_state, &stale_b_event);
    wire_free(&stale_b_event);
    let stale_selection_event: WireBuffer = wayland_clipboard_selection_event(
        4, stale_a_id);
    let stale_selection_dispatch: WaylandClipboardDispatch =
        wayland_clipboard_test_process(&stale_state, &stale_selection_event);
    wire_free(&stale_selection_event);
    failures = failures + wayland_clipboard_expect(stale_a_dispatch.valid == 1
        && stale_b_dispatch.valid == 1
        && wayland_clipboard_identity_equal(
            stale_b_dispatch.replaced, stale_a_dispatch.identity) == 1
        && stale_selection_dispatch.valid == 0
        && stale_selection_dispatch.error == WaylandClipboardError.InvalidSelection
        && stale_state.terminal == 1,
