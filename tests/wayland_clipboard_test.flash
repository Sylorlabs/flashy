    let mismatched_cleanup: WaylandClipboardIdentity =
        wayland_clipboard_register_source_commit(
            &mismatched_commit_state, 61, 0);
    failures = failures + wayland_clipboard_expect(mismatched_prepare.error == 0
        && mismatched_commit.valid == 0 && mismatched_cleanup.valid == 0
        && mismatched_commit_state.terminal == 1
        && mismatched_commit_state.error == WaylandClipboardError.InvalidState
        && mismatched_commit_state.prepared_source.valid == 0
        && len[WaylandClipboardSource](mismatched_commit_state.sources) == 0,
        "sent=1 mismatch terminals and clears provisional source authority");
    wire_free(&mismatched_prepare);
    wayland_clipboard_state_free(&mismatched_commit_state);

    let source_collision_state: WaylandClipboardState =
        wayland_clipboard_state_new(3, 4, 5);
    let colliding_offer_id: t27 = wayland_clipboard_test_server_id(0);
    let colliding_offer: WaylandClipboardIdentity = wayland_clipboard_add_offer(
