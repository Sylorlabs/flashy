            "post-authority MIME overflow remains nonterminal");
        wire_free(&unknown_event); free[u8](&unknown); early_i = early_i + 1;
    }
    let early_offer_index: i32 = wayland_clipboard_identity_offer_index(
        &early_mime_state, early_offer_dispatch.identity);
    failures = failures + wayland_clipboard_expect(early_offer_index >= 0
        && early_mime_state.offers.data[early_offer_index].authoritative == 1
        && early_mime_state.offers.data[early_offer_index].mime_rejected == 1,
