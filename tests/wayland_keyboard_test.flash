@import("../src/flashy.flash")

fn wayland_keyboard_expect(ok: i32, message: []u8) i32 {
    if (ok == 0) { _zag_print("FAIL "); _zag_println(message); return 1; }
    return 0;
}

fn wayland_keyboard_manual_keymap(keyboard_id: t27, format: t27, size: t27) WireBuffer {
    let payload: WireBuffer = wire_new(8);
    wire_push_u32_le(&payload, format); wire_push_u32_le(&payload, size);
    let out: WireBuffer = wayland_encode(keyboard_id, 0, &payload);
    wire_free(&payload); return out;
}

fn wayland_keyboard_manual_key(keyboard_id: t27, serial: t27, time: t27,
    key: t27, state: t27) WireBuffer {
    let payload: WireBuffer = wire_new(16);
    wire_push_u32_le(&payload, serial); wire_push_u32_le(&payload, time);
    wire_push_u32_le(&payload, key); wire_push_u32_le(&payload, state);
    let out: WireBuffer = wayland_encode(keyboard_id, 3, &payload);
    wire_free(&payload); return out;
}

fn wayland_keyboard_wire_range(input: *WireBuffer, first: i32, last: i32) WireBuffer {
    let out: WireBuffer = wire_new(last - first);
    if (first < 0 || last < first || last > len[u8](input.*.bytes)) {
        out.error = 1; return out;
    }
    let i: i32 = first;
    while (i < last) { wire_push_u8(&out, get[u8](input.*.bytes, i) as t27); i = i + 1; }
    return out;
}

fn wayland_keyboard_test_global(name: t27, interface: []u8) WaylandGlobal {
    return WaylandGlobal{ .name = name, .interface = interface,
        .interface_storage = ArrayList[u8]{ .data = null as *u8, .len = 0, .cap = 0 },
        .version = 1, .valid = 1 };
}

fn wayland_keyboard_test_window(surface_id: t27, xdg_surface_id: t27,
    toplevel_id: t27, buffer_id: t27) WaylandNativeWindow {
    return WaylandNativeWindow{ .surface_id = surface_id,
        .xdg_surface_id = xdg_surface_id, .toplevel_id = toplevel_id,
        .width = 640, .height = 480, .live = 1, .configured = 0,
        .close_requested = 0, .buffer_id = buffer_id,
        .buffer_width = 640, .buffer_height = 480,
        .memory = LinuxSharedMemory{ .fd = 0 - 1, .address = 0,
            .len = 0, .valid = 0 }, .buffer_busy = 0 };
}

// Test-only multi-descriptor sender. Production emission uses the exact-write
// transport; this raw fixture exercises malicious SCM_RIGHTS cardinality.
fn wayland_keyboard_send_many(socket_fd: i64, input: *WireBuffer,
    fds: *ArrayList[i64]) i64 {
    let packed: LinuxByteBuffer = linux_pack_wire(input);
    let count: i32 = len[i64](fds.*);
    if (socket_fd < 0 || packed.len < 1 || count < 1 || count > 16) {
        linux_buffer_free(&packed); return 0 - 22;
    }
    let iovec: LinuxByteBuffer = linux_buffer_new(16);
    linux_buffer_set_u64(&iovec, 0, packed.words.data as i64);
    linux_buffer_set_u64(&iovec, 8, packed.len as i64);
    let cmsg_len: i64 = 16 + (count as i64) * 4;
    let control_len: i32 = linux_cmsg_align(cmsg_len) as i32;
    let control: LinuxByteBuffer = linux_buffer_new(control_len);
    linux_buffer_set_u64(&control, 0, cmsg_len);
    linux_buffer_set_u32(&control, 8, 1); linux_buffer_set_u32(&control, 12, 1);
    let fd_i: i32 = 0;
    while (fd_i < count) {
        linux_buffer_set_u32(&control, 16 + fd_i * 4, get[i64](fds.*, fd_i));
        fd_i = fd_i + 1;
    }
    control.len = control_len;
    let message: LinuxByteBuffer = linux_buffer_new(56);
    linux_buffer_zero_storage(&message);
    linux_buffer_set_u64(&message, 16, iovec.words.data as i64);
    linux_buffer_set_u64(&message, 24, 1);
    linux_buffer_set_u64(&message, 32, control.words.data as i64);
    linux_buffer_set_u64(&message, 40, control_len as i64);
    message.len = 56;
    let sent: i64 = _zag_raw_syscall(linux_sys_sendmsg(), socket_fd,
        message.words.data as i64, 0, 0, 0, 0);
    linux_buffer_free(&message); linux_buffer_free(&control);
    linux_buffer_free(&iovec); linux_buffer_free(&packed);
    return sent;
}

fn main() i32 {
    let failures: i32 = 0;

    let get_keyboard: WireBuffer = wayland_seat_get_keyboard(9, 27);
    let get_keyboard_frame: WaylandFrame = wayland_decode(&get_keyboard, 0);
    failures = failures + wayland_keyboard_expect(get_keyboard_frame.valid == 1
        && get_keyboard_frame.object_id == 9 && get_keyboard_frame.opcode == 1
        && get_keyboard_frame.size == 12
        && wire_read_u32_le(&get_keyboard, get_keyboard_frame.payload_offset) == 27,
        "wl_seat.get_keyboard uses opcode 1 and an exact new-id payload");
    wire_free(&get_keyboard);

    let damage_v1: WireBuffer = wayland_surface_damage(4, 640, 480);
    let damage_v1_frame: WaylandFrame = wayland_decode(&damage_v1, 0);
    failures = failures + wayland_keyboard_expect(damage_v1_frame.valid == 1
        && damage_v1_frame.object_id == 4 && damage_v1_frame.opcode == 2
        && damage_v1_frame.size == 24
        && wire_read_i32_le(&damage_v1, damage_v1_frame.payload_offset) == 0
        && wire_read_i32_le(&damage_v1, damage_v1_frame.payload_offset + 4) == 0
        && wire_read_i32_le(&damage_v1, damage_v1_frame.payload_offset + 8) == 640
        && wire_read_i32_le(&damage_v1, damage_v1_frame.payload_offset + 12) == 480,
        "wl_surface.damage v1 fallback uses opcode 2 and an exact signed rectangle");
    wire_free(&damage_v1);

    let keymap_wire: WireBuffer = wayland_keyboard_keymap_event(27, 1, 5);
    let keymap_decoded: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &keymap_wire, wayland_decode(&keymap_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(keymap_decoded.valid == 1
        && keymap_decoded.kind == WaylandKeyboardEventKind.Keymap
        && keymap_decoded.keymap_format == 1 && keymap_decoded.keymap_size == 5,
        "wl_keyboard keymap frame decodes format and bounded size");
    wayland_keyboard_event_free(&keymap_decoded); wire_free(&keymap_wire);

    let no_keymap_wire: WireBuffer = wayland_keyboard_keymap_event(27, 0, 0);
    let no_keymap_decoded: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &no_keymap_wire, wayland_decode(&no_keymap_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(no_keymap_decoded.valid == 1
        && no_keymap_decoded.kind == WaylandKeyboardEventKind.Keymap
        && no_keymap_decoded.keymap_format == 0 && no_keymap_decoded.keymap_size == 0,
        "wl_keyboard no_keymap is a valid zero-byte authority withdrawal");
    wayland_keyboard_event_free(&no_keymap_decoded); wire_free(&no_keymap_wire);

    let keys: ArrayList[t27] = make[t27](2);
    push[t27](&keys, 30); push[t27](&keys, 42);
    let enter_wire: WireBuffer = wayland_keyboard_enter_event(27, 101, 99, &keys);
    let enter_decoded: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &enter_wire, wayland_decode(&enter_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(enter_decoded.valid == 1
        && enter_decoded.kind == WaylandKeyboardEventKind.Enter
        && enter_decoded.serial == 101 && enter_decoded.surface_id == 99
        && len[t27](enter_decoded.pressed_keys) == 2
        && get[t27](enter_decoded.pressed_keys, 0) == 30
        && get[t27](enter_decoded.pressed_keys, 1) == 42,
        "wl_keyboard enter decodes its exact u32 pressed-key array");
    wayland_keyboard_event_free(&enter_decoded);

    let malformed_array_payload: WireBuffer = wire_new(15);
    wire_push_u32_le(&malformed_array_payload, 102);
    wire_push_u32_le(&malformed_array_payload, 99);
    wire_push_u32_le(&malformed_array_payload, 3);
    wire_push_u8(&malformed_array_payload, 1); wire_push_u8(&malformed_array_payload, 2);
    wire_push_u8(&malformed_array_payload, 3);
    let malformed_array_wire: WireBuffer = wayland_encode(27, 1, &malformed_array_payload);
    let malformed_array: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &malformed_array_wire, wayland_decode(&malformed_array_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(malformed_array.valid == 0,
        "wl_keyboard rejects an enter array not divisible into u32 keys");
    wayland_keyboard_event_free(&malformed_array);
    wire_free(&malformed_array_wire); wire_free(&malformed_array_payload);

    let duplicate_payload: WireBuffer = wire_new(20);
    wire_push_u32_le(&duplicate_payload, 103); wire_push_u32_le(&duplicate_payload, 99);
    wire_push_u32_le(&duplicate_payload, 8); wire_push_u32_le(&duplicate_payload, 30);
    wire_push_u32_le(&duplicate_payload, 30);
    let duplicate_wire: WireBuffer = wayland_encode(27, 1, &duplicate_payload);
    let duplicate_enter: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &duplicate_wire, wayland_decode(&duplicate_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(duplicate_enter.valid == 0,
        "wl_keyboard rejects duplicate keys in the enter snapshot");
    wayland_keyboard_event_free(&duplicate_enter);
    wire_free(&duplicate_wire); wire_free(&duplicate_payload);

    let invalid_state_wire: WireBuffer = wayland_keyboard_manual_key(27, 104, 105, 46, 2);
    let invalid_state: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &invalid_state_wire, wayland_decode(&invalid_state_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(invalid_state.valid == 0,
        "wl_keyboard rejects key states outside released and pressed");
    wayland_keyboard_event_free(&invalid_state); wire_free(&invalid_state_wire);

    let repeat_wire: WireBuffer = wayland_empty_request(27, 5);
    let repeat_event: WaylandKeyboardEvent = wayland_decode_keyboard_event(
        &repeat_wire, wayland_decode(&repeat_wire, 0), 27);
    failures = failures + wayland_keyboard_expect(repeat_event.valid == 0,
        "wl_keyboard v3 rejects the unbound version-4 repeat_info opcode");
    wayland_keyboard_event_free(&repeat_event); wire_free(&repeat_wire);

    let seat_name_wire: WireBuffer = wayland_seat_name_event(7, "seat0");
    let malformed_seat_name: WireBuffer = wayland_u32_request(7, 1, 4);
    let oversized_seat_name_bytes: ArrayList[u8] = make[u8](257);
    let oversized_seat_i: i32 = 0;
    while (oversized_seat_i < 257) {
        push[u8](&oversized_seat_name_bytes, 's');
        oversized_seat_i = oversized_seat_i + 1;
    }
    let oversized_seat_name: WireBuffer = wayland_seat_name_event(7,
        oversized_seat_name_bytes.data[0..len[u8](oversized_seat_name_bytes)]);
    failures = failures + wayland_keyboard_expect(
        wayland_seat_name_event_valid(&seat_name_wire,
            wayland_decode(&seat_name_wire, 0), 7) == 1
        && wayland_seat_name_event_valid(&malformed_seat_name,
            wayland_decode(&malformed_seat_name, 0), 7) == 0
        && wayland_seat_name_event_valid(&oversized_seat_name,
            wayland_decode(&oversized_seat_name, 0), 7) == 0,
        "wl_seat v3 accepts exact bounded name events and rejects malformed or oversized strings");
    wire_free(&seat_name_wire); wire_free(&malformed_seat_name);
    wire_free(&oversized_seat_name); free[u8](&oversized_seat_name_bytes);

    let peer: LinuxFdPair = linux_socketpair_stream();
    failures = failures + wayland_keyboard_expect(peer.ok == 1,
        "Wayland keyboard fake peer opens a real Unix socketpair");
    if (peer.ok == 1) {
        let connection: WaylandNativeConnection = wayland_empty_connection();
        connection.fd = peer.first; connection.connected = 1;
        connection.seat_id = 7; connection.seat_version = 3; connection.next_id = 20;

        let keyboard_capability: WireBuffer = wayland_seat_capabilities_event(7, 2);
        failures = failures + wayland_keyboard_expect(wayland_process_seat_frame(&connection,
            &keyboard_capability, wayland_decode(&keyboard_capability, 0)) == 1
            && connection.seat_has_keyboard == 1 && connection.keyboard_id == 20
            && connection.next_id == 21 && connection.keyboard_version == 3,
            "keyboard capability binds a releasable wl_keyboard v3 object");
        let bind_call: WireBuffer = wayland_receive_frame(peer.second, 100);
        let bind_frame: WaylandFrame = wayland_decode(&bind_call, 0);
        failures = failures + wayland_keyboard_expect(bind_frame.valid == 1
            && bind_frame.object_id == 7 && bind_frame.opcode == 1 && bind_frame.size == 12
            && wire_read_u32_le(&bind_call, bind_frame.payload_offset) == 20,
            "fake peer observes the exact get_keyboard request");
        wire_free(&bind_call); wire_free(&keyboard_capability);

        let keymap_memory: LinuxSharedMemory = linux_shared_memory_create(5);
        failures = failures + wayland_keyboard_expect(keymap_memory.valid == 1,
            "keymap fixture owns a bounded CLOEXEC memfd");
        if (keymap_memory.valid == 1) {
            linux_shared_memory_set_byte(&keymap_memory, 0, 'x');
            linux_shared_memory_set_byte(&keymap_memory, 1, 'k');
            linux_shared_memory_set_byte(&keymap_memory, 2, 'b');
            linux_shared_memory_set_byte(&keymap_memory, 3, 10);
            linux_shared_memory_set_byte(&keymap_memory, 4, 0);

            let advanced_cursor: LinuxByteBuffer = linux_buffer_new(2);
            let advanced_read: i64 = linux_read_into(keymap_memory.fd, &advanced_cursor);
            failures = failures + wayland_keyboard_expect(advanced_read == 2,
                "keymap fixture advances the shared open-file cursor before transfer");
            linux_buffer_free(&advanced_cursor);

            let native_keymap_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
            let sent_keymap: i64 = linux_send_wire_fd(peer.second, &native_keymap_wire,
                keymap_memory.fd);
            let received_keymap: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let received_keymap_fd: i64 = received_keymap.received_fd;
            failures = failures + wayland_keyboard_expect(sent_keymap == 16
                && received_keymap.valid == 1 && received_keymap.has_fd == 1
                && received_keymap.fd_count == 1 && received_keymap.cloexec_applied == 1
                && linux_fd_flags(received_keymap_fd) >= 0
                && (linux_fd_flags(received_keymap_fd) % 2) == linux_fd_cloexec(),
                "recvmsg retains one keymap FD with close-on-exec");
            let native_keymap: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &received_keymap.input, wayland_decode(&received_keymap.input, 0), received_keymap_fd);
            received_keymap.received_fd = 0 - 1; received_keymap.has_fd = 0;
            failures = failures + wayland_keyboard_expect(native_keymap.valid == 1
                && native_keymap.kind == WaylandKeyboardEventKind.Keymap
                && len[u8](native_keymap.keymap_bytes) == 5
                && get[u8](native_keymap.keymap_bytes, 0) == 'x'
                && get[u8](native_keymap.keymap_bytes, 4) == 0
                && linux_fd_flags(received_keymap_fd) < 0,
                "read-only mmap starts at byte zero, retains trailing NUL, and closes its FD");
            failures = failures + wayland_keyboard_expect(
                wayland_connection_store_pending_keymap(&connection, &native_keymap) == 1
                && connection.keyboard_pending_keymap_ready == 1,
                "pre-dispatch loops can retain one owned raw keymap without copying");
            wayland_keyboard_event_free(&native_keymap);
            let pending_keymap: WaylandKeyboardAuthorityUpdate =
                wayland_connection_take_keyboard_authority(
                &connection);
            failures = failures + wayland_keyboard_expect(pending_keymap.valid == 1
                && pending_keymap.kind == WaylandKeyboardAuthorityKind.Map
                && pending_keymap.generation == 1 && pending_keymap.keymap_size == 5
                && len[u8](pending_keymap.keymap_bytes) == 5
                && connection.keyboard_pending_keymap_ready == 0
                && connection.keyboard_pending_authority_ready == 0,
                "shared parsing takes one generation-tagged raw map authority update");
            wayland_keyboard_authority_update_free(&pending_keymap);
            wire_free(&received_keymap.input); wire_free(&native_keymap_wire);

            let fragmented_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
            let fragmented_prefix: WireBuffer = wayland_keyboard_wire_range(&fragmented_wire, 0, 4);
            let fragmented_tail: WireBuffer = wayland_keyboard_wire_range(&fragmented_wire, 4,
                len[u8](fragmented_wire.bytes));
            let sent_fragment_prefix: i64 = linux_send_wire(peer.second, &fragmented_prefix);
            let sent_fragment_tail: i64 = linux_send_wire_fd(peer.second, &fragmented_tail,
                keymap_memory.fd);
            let fragmented_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let fragmented_fd: i64 = fragmented_receive.received_fd;
            let fragmented_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &fragmented_receive.input, wayland_decode(&fragmented_receive.input, 0),
                fragmented_fd);
            fragmented_receive.received_fd = 0 - 1; fragmented_receive.has_fd = 0;
            failures = failures + wayland_keyboard_expect(sent_fragment_prefix == 4
                && sent_fragment_tail == 12 && fragmented_receive.valid == 1
                && fragmented_receive.fd_count == 1 && fragmented_event.valid == 1
                && len[u8](fragmented_event.keymap_bytes) == 5
                && get[u8](fragmented_event.keymap_bytes, 0) == 'x'
                && linux_fd_flags(fragmented_fd) < 0,
                "recvmsg on every segment retains an FD attached after a fragmented header");
            wayland_keyboard_event_free(&fragmented_event);
            wire_free(&fragmented_receive.input); wire_free(&fragmented_tail);
            wire_free(&fragmented_prefix); wire_free(&fragmented_wire);

            let replacement_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
            let _sent_replacement: i64 = linux_send_wire_fd(peer.second, &replacement_wire,
                keymap_memory.fd);
            let replacement_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let replacement_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &replacement_receive.input, wayland_decode(&replacement_receive.input, 0),
                replacement_receive.received_fd);
            replacement_receive.received_fd = 0 - 1; replacement_receive.has_fd = 0;
            failures = failures + wayland_keyboard_expect(replacement_event.valid == 1
                && wayland_connection_store_pending_keymap(&connection, &replacement_event) == 1
                && connection.keyboard_pending_authority_kind == WaylandKeyboardAuthorityKind.Map,
                "a valid replacement map is pending before malicious ancillary replacement");
            wayland_keyboard_event_free(&replacement_event);
            wire_free(&replacement_receive.input); wire_free(&replacement_wire);

            let second_keymap_memory: LinuxSharedMemory = linux_shared_memory_create(5);
            failures = failures + wayland_keyboard_expect(second_keymap_memory.valid == 1,
                "multi-FD keymap fixture owns a second descriptor");
            if (second_keymap_memory.valid == 1) {
                let multi_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
                let multi_fds: ArrayList[i64] = make[i64](2);
                push[i64](&multi_fds, keymap_memory.fd);
                push[i64](&multi_fds, second_keymap_memory.fd);
                let sent_multi: i64 = wayland_keyboard_send_many(peer.second, &multi_wire,
                    &multi_fds);
                let multi_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                    peer.first, 100);
                let multi_accepted: i32 = wayland_connection_accept_frame_receive(&connection,
                    &multi_receive);
                failures = failures + wayland_keyboard_expect(sent_multi == 16
                    && multi_accepted == 1 && multi_receive.keyboard_authority_cleared == 1
                    && multi_receive.valid == 0 && multi_receive.input.error != 0
                    && multi_receive.fd_count == 2 && multi_receive.received_fd < 0
                    && multi_receive.closed_fd_count == 2 && multi_receive.last_closed_fd >= 0
                    && linux_fd_flags(multi_receive.last_closed_fd) < 0,
                    "keymap rejects multiple SCM_RIGHTS descriptors and closes all of them");
                let rejected_authority: WaylandKeyboardAuthorityUpdate =
                    wayland_connection_take_keyboard_authority(&connection);
                failures = failures + wayland_keyboard_expect(rejected_authority.valid == 1
                    && rejected_authority.kind == WaylandKeyboardAuthorityKind.Rejected
                    && len[u8](rejected_authority.keymap_bytes) == 0
                    && connection.keyboard_pending_keymap_ready == 0,
                    "ancillary-invalid replacement publishes rejection and removes stale map authority");
                wayland_keyboard_authority_update_free(&rejected_authority);
                wire_free(&multi_receive.input); free[i64](&multi_fds); wire_free(&multi_wire);
                linux_shared_memory_free(&second_keymap_memory);
            }

            let missing_fd_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
            let _sent_missing_fd: i64 = linux_send_wire(peer.second, &missing_fd_wire);
            let missing_fd_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let missing_fd_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &missing_fd_receive.input, wayland_decode(&missing_fd_receive.input, 0),
                missing_fd_receive.received_fd);
            missing_fd_receive.received_fd = 0 - 1;
            failures = failures + wayland_keyboard_expect(missing_fd_receive.valid == 1
                && missing_fd_receive.has_fd == 0 && missing_fd_event.valid == 0,
                "keymap event without SCM_RIGHTS is rejected");
            let missing_authority: WaylandKeyboardAuthorityUpdate =
                wayland_connection_take_keyboard_authority(&connection);
            failures = failures + wayland_keyboard_expect(missing_authority.valid == 1
                && missing_authority.kind == WaylandKeyboardAuthorityKind.Rejected,
                "missing keymap FD publishes an authoritative rejection");
            wayland_keyboard_authority_update_free(&missing_authority);
            wayland_keyboard_event_free(&missing_fd_event);
            wire_free(&missing_fd_receive.input); wire_free(&missing_fd_wire);

            let truncated_peer: LinuxFdPair = linux_socketpair_stream();
            failures = failures + wayland_keyboard_expect(truncated_peer.ok == 1,
                "truncated frame uses a disposable stream");
            if (truncated_peer.ok == 1) {
                let truncated_connection: WaylandNativeConnection = wayland_empty_connection();
                truncated_connection.fd = truncated_peer.first;
                truncated_connection.connected = 1;
                let terminal_map: WaylandKeyboardEvent = wayland_empty_keyboard_event();
                terminal_map.kind = WaylandKeyboardEventKind.Keymap;
                terminal_map.keymap_format = 1; terminal_map.keymap_size = 1;
                terminal_map.keymap_bytes = make[u8](1); push[u8](&terminal_map.keymap_bytes, 0);
                terminal_map.valid = 1;
                let _terminal_map_stored: i32 = wayland_connection_store_pending_keymap(
                    &truncated_connection, &terminal_map);
                wayland_keyboard_event_free(&terminal_map);
                let _terminal_surface_registered: i32 = wayland_connection_register_surface(
                    &truncated_connection, 55);
                truncated_connection.keyboard_focus_surface = 55;
                truncated_connection.keyboard_mods_depressed = 3;
                let truncated_frame: WireBuffer = wire_new(12);
                wire_push_u32_le(&truncated_frame, 20);
                wire_push_u32_le(&truncated_frame, 16 * 65536);
                wire_push_u32_le(&truncated_frame, 1);
                let _sent_truncated_frame: i64 = linux_send_wire_fd(truncated_peer.second,
                    &truncated_frame, keymap_memory.fd);
                let truncated_started: i64 = linux_monotonic_ms();
                let truncated_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                    truncated_connection.fd, 30);
                let truncated_elapsed: i64 = linux_monotonic_ms() - truncated_started;
                let truncated_accepted: i32 = wayland_connection_accept_frame_receive(
                    &truncated_connection, &truncated_receive);
                let terminal_authority: WaylandKeyboardAuthorityUpdate =
                    wayland_connection_take_keyboard_authority(&truncated_connection);
                failures = failures + wayland_keyboard_expect(truncated_receive.valid == 0
                    && truncated_receive.input.error != 0 && truncated_receive.received_fd < 0
                    && truncated_receive.stream_terminal == 1 && truncated_accepted == 0
                    && truncated_connection.fd < 0 && truncated_connection.connected == 0
                    && linux_fd_flags(truncated_peer.first) < 0
                    && truncated_receive.closed_fd_count >= 1
                    && truncated_receive.last_closed_fd >= 0
                    && linux_fd_flags(truncated_receive.last_closed_fd) < 0
                    && truncated_elapsed <= 200 && terminal_authority.valid == 0
                    && truncated_connection.keyboard_focus_surface == 0
                    && truncated_connection.keyboard_mods_depressed == 0
                    && len[t27](truncated_connection.owned_surface_ids) == 0,
                    "terminal acceptance retires stream, FD, authority, focus, and identities once");
                wayland_keyboard_authority_update_free(&terminal_authority);
                wire_free(&truncated_receive.input); wire_free(&truncated_frame);
                wayland_disconnect(&truncated_connection);
                let _close_truncated_server: i64 = linux_close(truncated_peer.second);
            }

            let oversized_wire: WireBuffer = wayland_keyboard_manual_keymap(20, 1,
                wayland_keyboard_keymap_max_size() + 1);
            let _sent_oversized: i64 = linux_send_wire_fd(peer.second, &oversized_wire,
                keymap_memory.fd);
            let oversized_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let oversized_fd: i64 = oversized_receive.received_fd;
            let oversized_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &oversized_receive.input, wayland_decode(&oversized_receive.input, 0), oversized_fd);
            oversized_receive.received_fd = 0 - 1;
            failures = failures + wayland_keyboard_expect(oversized_receive.valid == 1
                && oversized_event.valid == 0 && linux_fd_flags(oversized_fd) < 0,
                "oversized keymap is rejected and its descriptor is closed");
            wayland_keyboard_event_free(&oversized_event);
            wire_free(&oversized_receive.input); wire_free(&oversized_wire);

            let short_contents_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 7);
            let _sent_short_contents: i64 = linux_send_wire_fd(peer.second, &short_contents_wire,
                keymap_memory.fd);
            let short_contents_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let short_contents_fd: i64 = short_contents_receive.received_fd;
            let short_contents_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &short_contents_receive.input, wayland_decode(&short_contents_receive.input, 0),
                short_contents_fd);
            short_contents_receive.received_fd = 0 - 1;
            failures = failures + wayland_keyboard_expect(short_contents_event.valid == 0
                && linux_fd_flags(short_contents_fd) < 0,
                "truncated keymap contents fail exact read and close the descriptor");
            wayland_keyboard_event_free(&short_contents_event);
            wire_free(&short_contents_receive.input); wire_free(&short_contents_wire);

            let page_short_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 8192);
            let _sent_page_short: i64 = linux_send_wire_fd(peer.second, &page_short_wire,
                keymap_memory.fd);
            let page_short_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let page_short_fd: i64 = page_short_receive.received_fd;
            let page_short_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &page_short_receive.input, wayland_decode(&page_short_receive.input, 0),
                page_short_fd);
            page_short_receive.received_fd = 0 - 1;
            failures = failures + wayland_keyboard_expect(page_short_event.valid == 0
                && linux_fd_flags(page_short_fd) < 0,
                "file size validation rejects an advertised keymap beyond the backing pages");
            wayland_keyboard_event_free(&page_short_event);
            wire_free(&page_short_receive.input); wire_free(&page_short_wire);

            let nonmappable_pair: LinuxFdPair = linux_socketpair_stream();
            failures = failures + wayland_keyboard_expect(nonmappable_pair.ok == 1,
                "non-mappable keymap fixture owns a socket descriptor");
            if (nonmappable_pair.ok == 1) {
                let nonmappable_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
                let _sent_nonmappable: i64 = linux_send_wire_fd(peer.second, &nonmappable_wire,
                    nonmappable_pair.first);
                let nonmappable_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                    peer.first, 100);
                let nonmappable_fd: i64 = nonmappable_receive.received_fd;
                let nonmappable_started: i64 = linux_monotonic_ms();
                let nonmappable_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(
                    &connection, &nonmappable_receive.input,
                    wayland_decode(&nonmappable_receive.input, 0), nonmappable_fd);
                let nonmappable_elapsed: i64 = linux_monotonic_ms() - nonmappable_started;
                nonmappable_receive.received_fd = 0 - 1;
                failures = failures + wayland_keyboard_expect(nonmappable_event.valid == 0
                    && linux_fd_flags(nonmappable_fd) < 0 && nonmappable_elapsed <= 100,
                    "socket keymap FD fails promptly without a blocking read and is closed");
                wayland_keyboard_event_free(&nonmappable_event);
                wire_free(&nonmappable_receive.input); wire_free(&nonmappable_wire);
                let _close_nonmappable_first: i64 = linux_close(nonmappable_pair.first);
                let _close_nonmappable_second: i64 = linux_close(nonmappable_pair.second);
            }

            let map_before_withdrawal_wire: WireBuffer = wayland_keyboard_keymap_event(20, 1, 5);
            let _sent_map_before_withdrawal: i64 = linux_send_wire_fd(peer.second,
                &map_before_withdrawal_wire, keymap_memory.fd);
            let map_before_withdrawal_receive: WaylandNativeFrameReceive =
                wayland_receive_frame_with_fd(peer.first, 100);
            let map_before_withdrawal_event: WaylandKeyboardEvent =
                wayland_process_keyboard_frame(&connection, &map_before_withdrawal_receive.input,
                    wayland_decode(&map_before_withdrawal_receive.input, 0),
                    map_before_withdrawal_receive.received_fd);
            map_before_withdrawal_receive.received_fd = 0 - 1;
            let _stored_before_withdrawal: i32 = wayland_connection_store_pending_keymap(
                &connection, &map_before_withdrawal_event);
            wayland_keyboard_event_free(&map_before_withdrawal_event);
            wire_free(&map_before_withdrawal_receive.input);
            wire_free(&map_before_withdrawal_wire);

            let withdrawal_wire: WireBuffer = wayland_keyboard_keymap_event(20, 0, 0);
            let _sent_withdrawal: i64 = linux_send_wire(peer.second, &withdrawal_wire);
            let withdrawal_receive: WaylandNativeFrameReceive = wayland_receive_frame_with_fd(
                peer.first, 100);
            let withdrawal_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
                &withdrawal_receive.input, wayland_decode(&withdrawal_receive.input, 0),
                withdrawal_receive.received_fd);
            withdrawal_receive.received_fd = 0 - 1;
            let stored_withdrawal: i32 = wayland_connection_store_pending_keymap(
                &connection, &withdrawal_event);
            let withdrawn_authority: WaylandKeyboardAuthorityUpdate =
                wayland_connection_take_keyboard_authority(&connection);
            failures = failures + wayland_keyboard_expect(withdrawal_event.valid == 1
                && stored_withdrawal == 1 && withdrawn_authority.valid == 1
                && withdrawn_authority.kind == WaylandKeyboardAuthorityKind.Withdrawn
                && len[u8](withdrawn_authority.keymap_bytes) == 0
                && connection.keyboard_pending_keymap_ready == 0,
                "no_keymap consumed by an internal loop withdraws an earlier raw map authority");
            wayland_keyboard_authority_update_free(&withdrawn_authority);
            wayland_keyboard_event_free(&withdrawal_event);
            wire_free(&withdrawal_receive.input); wire_free(&withdrawal_wire);
        }

        failures = failures + wayland_keyboard_expect(
            wayland_connection_register_surface(&connection, 99) == 1,
            "keyboard focus fixture registers its owned wl_surface identity");
        let unknown_enter_wire: WireBuffer = wayland_keyboard_enter_event(20, 100, 100, &keys);
        let unknown_enter: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &unknown_enter_wire, wayland_decode(&unknown_enter_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(unknown_enter.valid == 0
            && connection.keyboard_focus_surface == 0,
            "unknown wl_surface enter cannot poison retained keyboard focus");
        wayland_keyboard_event_free(&unknown_enter); wire_free(&unknown_enter_wire);

        let native_enter_wire: WireBuffer = wayland_keyboard_enter_event(20, 101, 99, &keys);
        let focus_enter: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &native_enter_wire, wayland_decode(&native_enter_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(focus_enter.valid == 1
            && connection.keyboard_focus_surface == 99 && connection.keyboard_serial == 101
            && len[t27](connection.keyboard_pressed_keys) == 2,
            "keyboard enter routes focus and pressed state to its surface");
        wayland_keyboard_event_free(&focus_enter);

        let duplicate_press_wire: WireBuffer = wayland_keyboard_key_event(20, 106, 107, 30, 1);
        let duplicate_press: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &duplicate_press_wire, wayland_decode(&duplicate_press_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(duplicate_press.valid == 0
            && len[t27](connection.keyboard_pressed_keys) == 2,
            "duplicate pressed state is rejected without mutation");
        wayland_keyboard_event_free(&duplicate_press); wire_free(&duplicate_press_wire);

        let press_wire: WireBuffer = wayland_keyboard_key_event(20, 108, 109, 46, 1);
        let press_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &press_wire, wayland_decode(&press_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(press_event.valid == 1
            && press_event.surface_id == 99 && press_event.key == 46 && press_event.key_state == 1
            && connection.keyboard_time == 109 && connection.keyboard_key == 46
            && len[t27](connection.keyboard_pressed_keys) == 3,
            "raw evdev press retains serial, time, state, and focused surface");
        wayland_keyboard_event_free(&press_event); wire_free(&press_wire);

        let modifiers_wire: WireBuffer = wayland_keyboard_modifiers_event(20, 110, 3, 4, 5, 0);
        let modifiers_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &modifiers_wire, wayland_decode(&modifiers_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(modifiers_event.valid == 1
            && modifiers_event.surface_id == 99 && connection.keyboard_mods_depressed == 3
            && connection.keyboard_mods_latched == 4 && connection.keyboard_mods_locked == 5
            && connection.keyboard_group == 0,
            "modifier masks and group remain exact uninterpreted protocol state");
        wayland_keyboard_event_free(&modifiers_event); wire_free(&modifiers_wire);

        let release_wire: WireBuffer = wayland_keyboard_key_event(20, 111, 112, 46, 0);
        let release_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &release_wire, wayland_decode(&release_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(release_event.valid == 1
            && len[t27](connection.keyboard_pressed_keys) == 2,
            "raw evdev release removes the matching pressed state");
        wayland_keyboard_event_free(&release_event); wire_free(&release_wire);

        connection.keyboard_pressed_keys.len = 0;
        let bounded_i: t27 = 0;
        while (bounded_i < wayland_keyboard_max_pressed_keys()) {
            push[t27](&connection.keyboard_pressed_keys, bounded_i);
            bounded_i = bounded_i + 1;
        }
        let bounded_press_wire: WireBuffer = wayland_keyboard_key_event(20, 112, 113, 2000, 1);
        let bounded_press: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &bounded_press_wire, wayland_decode(&bounded_press_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(bounded_press.valid == 0
            && len[t27](connection.keyboard_pressed_keys) as t27
                == wayland_keyboard_max_pressed_keys(),
            "distinct presses cannot grow retained state past the 1024-key bound");
        wayland_keyboard_event_free(&bounded_press); wire_free(&bounded_press_wire);
        connection.keyboard_pressed_keys.len = 2;
        connection.keyboard_pressed_keys.data[0] = 30;
        connection.keyboard_pressed_keys.data[1] = 42;

        let stale_leave_wire: WireBuffer = wayland_keyboard_leave_event(20, 113, 100);
        let stale_leave: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &stale_leave_wire, wayland_decode(&stale_leave_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(stale_leave.valid == 0
            && connection.keyboard_focus_surface == 99,
            "stale keyboard leave cannot clear a different focused surface");
        wayland_keyboard_event_free(&stale_leave); wire_free(&stale_leave_wire);

        let leave_wire: WireBuffer = wayland_keyboard_leave_event(20, 114, 99);
        let leave_event: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &leave_wire, wayland_decode(&leave_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(leave_event.valid == 1
            && connection.keyboard_focus_surface == 0
            && len[t27](connection.keyboard_pressed_keys) == 0
            && connection.keyboard_mods_depressed == 0 && connection.keyboard_group == 0,
            "matching keyboard leave clears focus, keys, and modifier state");
        wayland_keyboard_event_free(&leave_event); wire_free(&leave_wire);

        let stale_key_wire: WireBuffer = wayland_keyboard_key_event(20, 115, 116, 46, 1);
        let stale_key: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &stale_key_wire, wayland_decode(&stale_key_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(stale_key.valid == 0,
            "key event without keyboard focus is rejected");
        wayland_keyboard_event_free(&stale_key); wire_free(&stale_key_wire);

        let focus_again: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &native_enter_wire, wayland_decode(&native_enter_wire, 0), 0 - 1);
        wayland_keyboard_event_free(&focus_again);
        let old_keyboard_id: t27 = connection.keyboard_id;
        let remove_keyboard: WireBuffer = wayland_seat_capabilities_event(7, 0);
        failures = failures + wayland_keyboard_expect(wayland_process_seat_frame(&connection,
            &remove_keyboard, wayland_decode(&remove_keyboard, 0)) == 1
            && connection.seat_has_keyboard == 0 && connection.keyboard_id == 0
            && connection.keyboard_focus_surface == 0
            && len[t27](connection.keyboard_pressed_keys) == 0,
            "capability loss retires wl_keyboard v3 and clears every state value");
        let release_call: WireBuffer = wayland_receive_frame(peer.second, 100);
        let release_frame: WaylandFrame = wayland_decode(&release_call, 0);
        failures = failures + wayland_keyboard_expect(release_frame.valid == 1
            && release_frame.object_id == old_keyboard_id && release_frame.opcode == 0
            && release_frame.size == 8,
            "v3 capability loss emits wl_keyboard.release for the retired identity");
        wire_free(&release_call);

        let duplicate_remove_result: i32 = wayland_process_seat_frame(&connection,
            &remove_keyboard, wayland_decode(&remove_keyboard, 0));
        let loss_authority: WaylandKeyboardAuthorityUpdate =
            wayland_connection_take_keyboard_authority(&connection);
        failures = failures + wayland_keyboard_expect(duplicate_remove_result == 1
            && loss_authority.valid == 1
            && loss_authority.kind == WaylandKeyboardAuthorityKind.Withdrawn,
            "duplicate absent capability cannot erase the unconsumed withdrawal update");
        wayland_keyboard_authority_update_free(&loss_authority);

        let stale_old_key: WaylandKeyboardEvent = wayland_process_keyboard_frame(&connection,
            &native_enter_wire, wayland_decode(&native_enter_wire, 0), 0 - 1);
        failures = failures + wayland_keyboard_expect(stale_old_key.valid == 0,
            "retired keyboard identity cannot route stale events");
        wayland_keyboard_event_free(&stale_old_key);

        let restore_keyboard: WireBuffer = wayland_seat_capabilities_event(7, 2);
        failures = failures + wayland_keyboard_expect(wayland_process_seat_frame(&connection,
            &restore_keyboard, wayland_decode(&restore_keyboard, 0)) == 1
            && connection.keyboard_id > old_keyboard_id,
            "restored keyboard capability allocates a fresh object identity");
        let restore_call: WireBuffer = wayland_receive_frame(peer.second, 100);
        let restore_frame: WaylandFrame = wayland_decode(&restore_call, 0);
        failures = failures + wayland_keyboard_expect(restore_frame.valid == 1
            && restore_frame.object_id == 7 && restore_frame.opcode == 1
            && wire_read_u32_le(&restore_call, restore_frame.payload_offset)
                == connection.keyboard_id,
            "fake peer observes get_keyboard with the fresh identity");
        wire_free(&restore_call);

        let churn_i: i32 = 0;
        while (churn_i < 8) {
            let churn_old_id: t27 = connection.keyboard_id;
            let churn_remove: WireBuffer = wayland_seat_capabilities_event(7, 0);
            let churn_removed: i32 = wayland_process_seat_frame(&connection, &churn_remove,
                wayland_decode(&churn_remove, 0));
            let churn_release: WireBuffer = wayland_receive_frame(peer.second, 100);
            let churn_release_frame: WaylandFrame = wayland_decode(&churn_release, 0);
            let churn_withdrawal: WaylandKeyboardAuthorityUpdate =
                wayland_connection_take_keyboard_authority(&connection);
            failures = failures + wayland_keyboard_expect(churn_removed == 1
                && churn_release_frame.valid == 1
                && churn_release_frame.object_id == churn_old_id
                && churn_release_frame.opcode == 0 && churn_release_frame.size == 8
                && churn_withdrawal.valid == 1
                && churn_withdrawal.kind == WaylandKeyboardAuthorityKind.Withdrawn,
                "keyboard churn releases each v3 resource and publishes withdrawal");
            wayland_keyboard_authority_update_free(&churn_withdrawal);
            wire_free(&churn_release); wire_free(&churn_remove);

            let churn_restore: WireBuffer = wayland_seat_capabilities_event(7, 2);
            let churn_restored: i32 = wayland_process_seat_frame(&connection, &churn_restore,
                wayland_decode(&churn_restore, 0));
            let churn_get: WireBuffer = wayland_receive_frame(peer.second, 100);
            let churn_get_frame: WaylandFrame = wayland_decode(&churn_get, 0);
            failures = failures + wayland_keyboard_expect(churn_restored == 1
                && connection.keyboard_id > churn_old_id
                && churn_get_frame.valid == 1 && churn_get_frame.object_id == 7
                && churn_get_frame.opcode == 1
                && wire_read_u32_le(&churn_get, churn_get_frame.payload_offset)
                    == connection.keyboard_id,
                "keyboard churn allocates a fresh identity after each exact release");
            wire_free(&churn_get); wire_free(&churn_restore);
            churn_i = churn_i + 1;
        }
        wire_free(&remove_keyboard); wire_free(&restore_keyboard);

        if (keymap_memory.valid == 1) { linux_shared_memory_free(&keymap_memory); }
        wire_free(&native_enter_wire); wire_free(&enter_wire); free[t27](&keys);
        wayland_disconnect(&connection);
        let _close_server: i64 = linux_close(peer.second);
    } else {
        wire_free(&enter_wire); free[t27](&keys);
    }

    let resource_peer: LinuxFdPair = linux_socketpair_stream();
    failures = failures + wayland_keyboard_expect(resource_peer.ok == 1,
        "v3 child-resource fixture opens a Unix socketpair");
    if (resource_peer.ok == 1) {
        let resource_connection: WaylandNativeConnection = wayland_empty_connection();
        resource_connection.fd = resource_peer.first; resource_connection.connected = 1;
        resource_connection.seat_id = 70; resource_connection.seat_version = 3;
        resource_connection.next_id = 71;
        let both_capabilities: WireBuffer = wayland_seat_capabilities_event(70, 3);
        let both_bound: i32 = wayland_process_seat_frame(&resource_connection,
            &both_capabilities, wayland_decode(&both_capabilities, 0));
        let pointer_get: WireBuffer = wayland_receive_frame(resource_peer.second, 100);
        let keyboard_get: WireBuffer = wayland_receive_frame(resource_peer.second, 100);
        let pointer_get_frame: WaylandFrame = wayland_decode(&pointer_get, 0);
        let keyboard_get_frame: WaylandFrame = wayland_decode(&keyboard_get, 0);
        let resource_pointer_id: t27 = resource_connection.pointer_id;
        let resource_keyboard_id: t27 = resource_connection.keyboard_id;
        failures = failures + wayland_keyboard_expect(both_bound == 1
            && resource_connection.pointer_version == 3
            && resource_connection.keyboard_version == 3
            && pointer_get_frame.valid == 1 && pointer_get_frame.object_id == 70
            && pointer_get_frame.opcode == 0
            && wire_read_u32_le(&pointer_get, pointer_get_frame.payload_offset)
                == resource_pointer_id
            && keyboard_get_frame.valid == 1 && keyboard_get_frame.object_id == 70
            && keyboard_get_frame.opcode == 1
            && wire_read_u32_le(&keyboard_get, keyboard_get_frame.payload_offset)
                == resource_keyboard_id,
            "seat v3 binds pointer and keyboard children with exact object requests");
        wire_free(&pointer_get); wire_free(&keyboard_get);

        let no_capabilities: WireBuffer = wayland_seat_capabilities_event(70, 0);
        let both_released: i32 = wayland_process_seat_frame(&resource_connection,
            &no_capabilities, wayland_decode(&no_capabilities, 0));
        let pointer_release: WireBuffer = wayland_receive_frame(resource_peer.second, 100);
        let keyboard_release: WireBuffer = wayland_receive_frame(resource_peer.second, 100);
        let pointer_release_frame: WaylandFrame = wayland_decode(&pointer_release, 0);
        let keyboard_release_frame: WaylandFrame = wayland_decode(&keyboard_release, 0);
        failures = failures + wayland_keyboard_expect(both_released == 1
            && pointer_release_frame.valid == 1
            && pointer_release_frame.object_id == resource_pointer_id
            && pointer_release_frame.opcode == 1 && pointer_release_frame.size == 8
            && keyboard_release_frame.valid == 1
            && keyboard_release_frame.object_id == resource_keyboard_id
            && keyboard_release_frame.opcode == 0 && keyboard_release_frame.size == 8,
            "seat v3 capability loss emits exact pointer.release and keyboard.release requests");
        let resource_withdrawal: WaylandKeyboardAuthorityUpdate =
            wayland_connection_take_keyboard_authority(&resource_connection);
        wayland_keyboard_authority_update_free(&resource_withdrawal);
        wire_free(&pointer_release); wire_free(&keyboard_release);
        wire_free(&no_capabilities); wire_free(&both_capabilities);
        wayland_disconnect(&resource_connection);
        let _close_resource_peer: i64 = linux_close(resource_peer.second);
    }

    let bind_peer: LinuxFdPair = linux_socketpair_stream();
    failures = failures + wayland_keyboard_expect(bind_peer.ok == 1,
        "seat-version binding fixture opens a Unix socketpair");
    if (bind_peer.ok == 1) {
        let bind_connection: WaylandNativeConnection = wayland_empty_connection();
        bind_connection.fd = bind_peer.first; bind_connection.connected = 1;
        bind_connection.registry_ready = 1;
        let bind_compositor_global: WaylandGlobal = wayland_keyboard_test_global(10,
            "wl_compositor"); bind_compositor_global.version = 6;
        let bind_shell_global: WaylandGlobal = wayland_keyboard_test_global(11,
            "xdg_wm_base"); bind_shell_global.version = 6;
        let bind_shm_global: WaylandGlobal = wayland_keyboard_test_global(12, "wl_shm");
        let bind_seat_global: WaylandGlobal = wayland_keyboard_test_global(13, "wl_seat");
        bind_seat_global.version = 9;
        let bind_clipboard_global: WaylandGlobal = wayland_keyboard_test_global(
            14, "wl_data_device_manager");
        bind_clipboard_global.version = 3;
        let recorded_bind_globals: i32 = wayland_record_global(&bind_connection,
            bind_compositor_global) * wayland_record_global(&bind_connection, bind_shell_global)
            * wayland_record_global(&bind_connection, bind_shm_global)
            * wayland_record_global(&bind_connection, bind_seat_global)
            * wayland_record_global(&bind_connection, bind_clipboard_global);
        let shell_bound: i32 = wayland_bind_shell(&bind_connection);
        let bind_compositor_call: WireBuffer = wayland_receive_frame(bind_peer.second, 100);
        let bind_shell_call: WireBuffer = wayland_receive_frame(bind_peer.second, 100);
        let bind_shm_call: WireBuffer = wayland_receive_frame(bind_peer.second, 100);
        let bind_seat_call: WireBuffer = wayland_receive_frame(bind_peer.second, 100);
        let bind_clipboard_call: WireBuffer = wayland_receive_frame(
            bind_peer.second, 100);
        let get_device_call: WireBuffer = wayland_receive_frame(
            bind_peer.second, 100);
        let bind_seat_frame: WaylandFrame = wayland_decode(&bind_seat_call, 0);
        let bind_clipboard_frame: WaylandFrame = wayland_decode(
            &bind_clipboard_call, 0);
