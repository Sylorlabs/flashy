    let validation_connection: WaylandNativeConnection = wayland_empty_connection();
    let first_global: WaylandGlobal = wayland_keyboard_test_global(1, "wl_output");
    let duplicate_global: WaylandGlobal = wayland_keyboard_test_global(1, "wl_seat");
    let invalid_name_global: WaylandGlobal = wayland_keyboard_test_global(2, "bad name");
    let too_long_global: WaylandGlobal = wayland_keyboard_test_global(3,
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    failures = failures + wayland_keyboard_expect(
        wayland_record_global(&validation_connection, first_global) == 1
        && wayland_record_global(&validation_connection, duplicate_global) == 0
        && wayland_record_global(&validation_connection, invalid_name_global) == 0
        && wayland_record_global(&validation_connection, too_long_global) == 0
        && len[WaylandGlobal](validation_connection.globals) == 1,
        "registry rejects duplicate names, invalid interface bytes, and oversized names");
    wayland_disconnect(&validation_connection);

    let total_connection: WaylandNativeConnection = wayland_empty_connection();
    let interface_128: []u8 =
