    let failed_send_connection: WaylandNativeConnection = wayland_empty_connection();
    failed_send_connection.connected = 1;
    let failed_send_map: WaylandKeyboardEvent = wayland_empty_keyboard_event();
    failed_send_map.kind = WaylandKeyboardEventKind.Keymap;
    failed_send_map.keymap_format = 1; failed_send_map.keymap_size = 1;
