        authority_queue_connection.connected = 1;
        authority_queue_connection.seat_has_keyboard = 1;
        authority_queue_connection.keyboard_id = 611;
        authority_queue_connection.keyboard_version = 3;
        let authority_queue_window: WaylandNativeWindow = wayland_keyboard_test_window(
            619, 620, 621, 0);
        let map_a_memory: LinuxSharedMemory = linux_shared_memory_create(2);
        let map_b_memory: LinuxSharedMemory = linux_shared_memory_create(2);
        failures = failures + wayland_keyboard_expect(map_a_memory.valid == 1
            && map_b_memory.valid == 1,
            "ordered keymap fixture creates two bounded read-only map sources");
        if (map_a_memory.valid == 1 && map_b_memory.valid == 1) {
            linux_shared_memory_set_byte(&map_a_memory, 0, 'a');
            linux_shared_memory_set_byte(&map_a_memory, 1, 0);
            linux_shared_memory_set_byte(&map_b_memory, 0, 'b');
            linux_shared_memory_set_byte(&map_b_memory, 1, 0);
            let map_a_wire: WireBuffer = wayland_keyboard_keymap_event(611, 1, 2);
            let key_a_wire: WireBuffer = wayland_keyboard_key_event(611, 1, 2, 30, 1);
            let map_b_wire: WireBuffer = wayland_keyboard_keymap_event(611, 1, 2);
            let key_b_wire: WireBuffer = wayland_keyboard_key_event(611, 3, 4, 31, 1);
            let authority_target_configure: WireBuffer =
                wayland_xdg_surface_configure(620, 99);
            let authority_queue_sent: i32 = 1;
            if (linux_send_wire_fd(authority_queue_peer.second, &map_a_wire,
                map_a_memory.fd) != len[u8](map_a_wire.bytes) as i64) {
                authority_queue_sent = 0;
            }
            if (linux_send_wire(authority_queue_peer.second, &key_a_wire)
                != len[u8](key_a_wire.bytes) as i64) { authority_queue_sent = 0; }
            if (linux_send_wire_fd(authority_queue_peer.second, &map_b_wire,
                map_b_memory.fd) != len[u8](map_b_wire.bytes) as i64) {
                authority_queue_sent = 0;
            }
            if (linux_send_wire(authority_queue_peer.second, &key_b_wire)
                != len[u8](key_b_wire.bytes) as i64) { authority_queue_sent = 0; }
            if (linux_send_wire(authority_queue_peer.second, &authority_target_configure)
                != len[u8](authority_target_configure.bytes) as i64) {
                authority_queue_sent = 0;
            }
            let authority_wait_ok: i32 = wayland_wait_window_configure(
                &authority_queue_connection, &authority_queue_window, 500);
            let authority_ack: WireBuffer = wayland_receive_frame(
                authority_queue_peer.second, 100);
            let authority_queue_bytes: t27 = authority_queue_connection.pending_frame_bytes;
            let authority_a: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&authority_queue_connection);
            let raw_key_a: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&authority_queue_connection);
            let authority_b: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&authority_queue_connection);
            let raw_key_b: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&authority_queue_connection);
            let decoded_key_a: WaylandKeyboardEvent = wayland_decode_keyboard_event(
                &raw_key_a.input, wayland_decode(&raw_key_a.input, 0), 611);
            let decoded_key_b: WaylandKeyboardEvent = wayland_decode_keyboard_event(
                &raw_key_b.input, wayland_decode(&raw_key_b.input, 0), 611);
            failures = failures + wayland_keyboard_expect(authority_queue_sent == 1
                && authority_wait_ok == 1 && authority_queue_bytes == 52
                && authority_a.valid == 1
                && authority_a.kind == WaylandNativePendingKind.KeyboardAuthority
                && authority_a.authority.kind == WaylandKeyboardAuthorityKind.Map
                && authority_a.authority.generation == 1
                && len[u8](authority_a.authority.keymap_bytes) == 2
                && get[u8](authority_a.authority.keymap_bytes, 0) == 'a'
                && raw_key_a.valid == 1 && raw_key_a.kind == WaylandNativePendingKind.Frame
                && decoded_key_a.valid == 1 && decoded_key_a.key == 30
                && authority_b.valid == 1
                && authority_b.kind == WaylandNativePendingKind.KeyboardAuthority
                && authority_b.authority.kind == WaylandKeyboardAuthorityKind.Map
                && authority_b.authority.generation == 2
                && len[u8](authority_b.authority.keymap_bytes) == 2
                && get[u8](authority_b.authority.keymap_bytes, 0) == 'b'
                && raw_key_b.valid == 1 && raw_key_b.kind == WaylandNativePendingKind.Frame
                && decoded_key_b.valid == 1 && decoded_key_b.key == 31
                && len[WaylandNativeQueuedFrame](authority_queue_connection.pending_frames) == 0
                && authority_queue_connection.pending_frame_bytes == 0,
                "map A, key A, map B, key B retain exact stream authority order");
            wayland_keyboard_event_free(&decoded_key_a);
            wayland_keyboard_event_free(&decoded_key_b);
            wayland_native_pending_event_free(&authority_a);
            wayland_native_pending_event_free(&raw_key_a);
            wayland_native_pending_event_free(&authority_b);
            wayland_native_pending_event_free(&raw_key_b);
            wire_free(&authority_ack); wire_free(&map_a_wire); wire_free(&key_a_wire);
            wire_free(&map_b_wire); wire_free(&key_b_wire);
            wire_free(&authority_target_configure);
        }
        if (map_a_memory.valid == 1) { linux_shared_memory_free(&map_a_memory); }
        if (map_b_memory.valid == 1) { linux_shared_memory_free(&map_b_memory); }
        wayland_disconnect(&authority_queue_connection);
        let _close_authority_queue_peer: i64 = linux_close(authority_queue_peer.second);
    }

    let rejected_queue_peer: LinuxFdPair = linux_socketpair_stream();
    failures = failures + wayland_keyboard_expect(rejected_queue_peer.ok == 1,
        "queued rejected-keymap fixture opens a Unix socketpair");
    if (rejected_queue_peer.ok == 1) {
        let rejected_queue_connection: WaylandNativeConnection = wayland_empty_connection();
        rejected_queue_connection.fd = rejected_queue_peer.first;
        rejected_queue_connection.connected = 1;
        rejected_queue_connection.seat_has_keyboard = 1;
        rejected_queue_connection.keyboard_id = 630;
        rejected_queue_connection.keyboard_version = 3;
        let rejected_queue_window: WaylandNativeWindow = wayland_keyboard_test_window(
            631, 632, 633, 0);
        let rejected_fd_a: LinuxSharedMemory = linux_shared_memory_create(1);
        let rejected_fd_b: LinuxSharedMemory = linux_shared_memory_create(1);
        if (rejected_fd_a.valid == 1 && rejected_fd_b.valid == 1) {
            let rejected_wire: WireBuffer = wayland_keyboard_keymap_event(630, 1, 1);
            let rejected_fds: ArrayList[i64] = make[i64](2);
            push[i64](&rejected_fds, rejected_fd_a.fd);
            push[i64](&rejected_fds, rejected_fd_b.fd);
            let rejected_sent: i64 = wayland_keyboard_send_many(
                rejected_queue_peer.second, &rejected_wire, &rejected_fds);
            let rejected_target: WireBuffer = wayland_xdg_surface_configure(632, 101);
            let _rejected_target_sent: i64 = linux_send_wire(
                rejected_queue_peer.second, &rejected_target);
            let rejected_wait_ok: i32 = wayland_wait_window_configure(
                &rejected_queue_connection, &rejected_queue_window, 500);
            let rejected_ack: WireBuffer = wayland_receive_frame(
                rejected_queue_peer.second, 100);
            let rejected_once: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&rejected_queue_connection);
            let rejected_twice: WaylandNativePendingEvent =
                wayland_connection_take_pending_event(&rejected_queue_connection);
            failures = failures + wayland_keyboard_expect(rejected_sent == 16
                && rejected_wait_ok == 1 && rejected_once.valid == 1
                && rejected_once.kind == WaylandNativePendingKind.KeyboardAuthority
                && rejected_once.authority.kind == WaylandKeyboardAuthorityKind.Rejected
                && rejected_once.authority.generation == 1
                && rejected_twice.valid == 0
                && rejected_queue_connection.keyboard_authority_generation == 1,
                "one ancillary-invalid keymap yields exactly one ordered rejection generation");
            wayland_native_pending_event_free(&rejected_once);
            wayland_native_pending_event_free(&rejected_twice);
            wire_free(&rejected_ack); wire_free(&rejected_target);
            wire_free(&rejected_wire); free[i64](&rejected_fds);
        } else {
            failures = failures + wayland_keyboard_expect(0,
                "queued rejected-keymap fixture creates both descriptor sources");
        }
        if (rejected_fd_a.valid == 1) { linux_shared_memory_free(&rejected_fd_a); }
        if (rejected_fd_b.valid == 1) { linux_shared_memory_free(&rejected_fd_b); }
        wayland_disconnect(&rejected_queue_connection);
        let _close_rejected_queue_peer: i64 = linux_close(rejected_queue_peer.second);
    }

    let partial_axis_peer: LinuxFdPair = linux_socketpair_stream();
    failures = failures + wayland_keyboard_expect(partial_axis_peer.ok == 1,
        "partial-zero configure fixture opens a Unix socketpair");
    if (partial_axis_peer.ok == 1) {
        let partial_axis_connection: WaylandNativeConnection = wayland_empty_connection();
        partial_axis_connection.fd = partial_axis_peer.first;
        partial_axis_connection.connected = 1;
        let partial_axis_window: WaylandNativeWindow = wayland_keyboard_test_window(
            640, 641, 642, 0);
        let zero_width_configure: WireBuffer = wayland_xdg_toplevel_configure(642, 0, 600);
        let zero_height_configure: WireBuffer = wayland_xdg_toplevel_configure(642, 800, 0);
        let both_zero_configure: WireBuffer = wayland_xdg_toplevel_configure(642, 0, 0);
        let queued_target_close: WireBuffer = wayland_empty_request(642, 1);
        let partial_axis_target: WireBuffer = wayland_xdg_surface_configure(641, 100);
        let partial_axis_sent: i32 = 1;
        if (linux_send_wire(partial_axis_peer.second, &zero_width_configure)
            != len[u8](zero_width_configure.bytes) as i64) { partial_axis_sent = 0; }
        if (linux_send_wire(partial_axis_peer.second, &zero_height_configure)
            != len[u8](zero_height_configure.bytes) as i64) { partial_axis_sent = 0; }
        if (linux_send_wire(partial_axis_peer.second, &both_zero_configure)
            != len[u8](both_zero_configure.bytes) as i64) { partial_axis_sent = 0; }
        if (linux_send_wire(partial_axis_peer.second, &queued_target_close)
            != len[u8](queued_target_close.bytes) as i64) { partial_axis_sent = 0; }
        if (linux_send_wire(partial_axis_peer.second, &partial_axis_target)
            != len[u8](partial_axis_target.bytes) as i64) { partial_axis_sent = 0; }
        let partial_axis_ok: i32 = wayland_wait_window_configure(
            &partial_axis_connection, &partial_axis_window, 500);
        let partial_axis_ack: WireBuffer = wayland_receive_frame(
            partial_axis_peer.second, 100);
        let pending_target_close: WaylandNativePendingEvent =
            wayland_connection_take_pending_event(&partial_axis_connection);
        let pending_target_close_frame: WaylandFrame = wayland_decode(
            &pending_target_close.input, 0);
        failures = failures + wayland_keyboard_expect(partial_axis_sent == 1
            && partial_axis_ok == 1 && partial_axis_window.width == 800
            && partial_axis_window.height == 600
            && partial_axis_window.close_requested == 0
            && pending_target_close.valid == 1
            && pending_target_close.kind == WaylandNativePendingKind.Frame
            && pending_target_close_frame.object_id == 642
            && pending_target_close_frame.opcode == 1
            && partial_axis_connection.connected == 1,
            "partial-zero configure resolves atomically while target close remains queued for app dispatch");
        wayland_native_pending_event_free(&pending_target_close);
        wire_free(&partial_axis_ack); wire_free(&zero_width_configure);
        wire_free(&zero_height_configure); wire_free(&both_zero_configure);
        wire_free(&queued_target_close); wire_free(&partial_axis_target);
        wayland_disconnect(&partial_axis_connection);
        let _close_partial_axis_peer: i64 = linux_close(partial_axis_peer.second);
    }

    let callback_peer: LinuxFdPair = linux_socketpair_stream();
    if (callback_peer.ok == 1) {
        let callback_connection: WaylandNativeConnection = wayland_empty_connection();
        callback_connection.fd = callback_peer.first; callback_connection.connected = 1;
        let callback_map: WaylandKeyboardEvent = wayland_empty_keyboard_event();
        callback_map.kind = WaylandKeyboardEventKind.Keymap;
        callback_map.keymap_format = 1; callback_map.keymap_size = 1;
        callback_map.keymap_bytes = make[u8](1); push[u8](&callback_map.keymap_bytes, 0);
        callback_map.valid = 1;
        let _callback_map_stored: i32 = wayland_connection_store_pending_keymap(
            &callback_connection, &callback_map);
        wayland_keyboard_event_free(&callback_map);
        let callback_queued_wire: WireBuffer = wayland_empty_request(81, 0);
        let _callback_queued: i32 = wayland_connection_queue_pending_frame(
            &callback_connection, &callback_queued_wire);
        let bad_callback: WireBuffer = wayland_empty_request(3, 0);
        let _bad_callback_sent: i64 = linux_send_wire(callback_peer.second, &bad_callback);
        let callback_ok: i32 = wayland_finish_registry(&callback_connection, 100);
        let callback_authority: WaylandKeyboardAuthorityUpdate =
            wayland_connection_take_keyboard_authority(&callback_connection);
        let callback_pending: WaylandNativeFrameReceive =
            wayland_connection_take_pending_frame(&callback_connection);
        failures = failures + wayland_keyboard_expect(callback_ok == 0
            && callback_connection.connected == 0 && callback_connection.fd < 0
            && callback_authority.valid == 0 && callback_pending.valid == 0,
            "schema retirement clears callback setup, authority, and queued frames");
        wayland_keyboard_authority_update_free(&callback_authority);
        wayland_native_frame_free(&callback_pending);
        wire_free(&bad_callback); wayland_disconnect(&callback_connection);
        let _close_callback_peer: i64 = linux_close(callback_peer.second);
    } else { failures = failures + wayland_keyboard_expect(0, "callback schema fixture opens"); }

    let surface_schema_peer: LinuxFdPair = linux_socketpair_stream();
    if (surface_schema_peer.ok == 1) {
        let surface_schema_connection: WaylandNativeConnection = wayland_empty_connection();
        surface_schema_connection.fd = surface_schema_peer.first;
        surface_schema_connection.connected = 1;
        let surface_schema_window: WaylandNativeWindow = wayland_keyboard_test_window(530, 531, 532, 0);
        let bad_surface_configure: WireBuffer = wayland_empty_request(531, 0);
        let _bad_surface_sent: i64 = linux_send_wire(surface_schema_peer.second,
            &bad_surface_configure);
        let surface_schema_ok: i32 = wayland_wait_window_configure(
            &surface_schema_connection, &surface_schema_window, 100);
        failures = failures + wayland_keyboard_expect(surface_schema_ok == 0
            && surface_schema_window.configured == 0
            && surface_schema_connection.connected == 0,
            "malformed xdg_surface.configure cannot configure a window");
        wire_free(&bad_surface_configure); wayland_disconnect(&surface_schema_connection);
        let _close_surface_schema_peer: i64 = linux_close(surface_schema_peer.second);
    } else { failures = failures + wayland_keyboard_expect(0, "surface schema fixture opens"); }

    let toplevel_schema_peer: LinuxFdPair = linux_socketpair_stream();
    if (toplevel_schema_peer.ok == 1) {
        let toplevel_schema_connection: WaylandNativeConnection = wayland_empty_connection();
        toplevel_schema_connection.fd = toplevel_schema_peer.first;
        toplevel_schema_connection.connected = 1;
        let toplevel_schema_window: WaylandNativeWindow = wayland_keyboard_test_window(540, 541, 542, 0);
        let oversized_configure: WireBuffer = wayland_xdg_toplevel_configure(542,
            surface_max_dimension() + 1, 480);
        let _oversized_configure_sent: i64 = linux_send_wire(toplevel_schema_peer.second,
            &oversized_configure);
        let toplevel_schema_ok: i32 = wayland_wait_window_configure(
            &toplevel_schema_connection, &toplevel_schema_window, 100);
        failures = failures + wayland_keyboard_expect(toplevel_schema_ok == 0
            && toplevel_schema_window.width == 640
            && toplevel_schema_connection.connected == 0,
            "oversized signed toplevel dimensions fail before state mutation");
        wire_free(&oversized_configure); wayland_disconnect(&toplevel_schema_connection);
        let _close_toplevel_schema_peer: i64 = linux_close(toplevel_schema_peer.second);
    } else { failures = failures + wayland_keyboard_expect(0, "toplevel schema fixture opens"); }

    let malformed_states_payload: WireBuffer = wire_new(15);
    wire_push_i32_le(&malformed_states_payload, 640);
    wire_push_i32_le(&malformed_states_payload, 480);
    wire_push_u32_le(&malformed_states_payload, 3);
    wire_push_u8(&malformed_states_payload, 1); wire_push_u8(&malformed_states_payload, 2);
    wire_push_u8(&malformed_states_payload, 3);
    let malformed_states_wire: WireBuffer = wayland_encode(542, 0, &malformed_states_payload);
    let malformed_close_wire: WireBuffer = wayland_u32_request(542, 1, 1);
    failures = failures + wayland_keyboard_expect(
        wayland_native_toplevel_configure_valid(&malformed_states_wire,
            wayland_decode(&malformed_states_wire, 0), 542, 640, 480) == 0
        && wayland_native_event_exact(wayland_decode(&malformed_close_wire, 0),
            542, 1, 8) == 0,
        "toplevel states arrays and close events require exact schemas");
    wire_free(&malformed_states_wire); wire_free(&malformed_states_payload);
    wire_free(&malformed_close_wire);

    let buffer_schema_peer: LinuxFdPair = linux_socketpair_stream();
    if (buffer_schema_peer.ok == 1) {
        let buffer_schema_connection: WaylandNativeConnection = wayland_empty_connection();
        buffer_schema_connection.fd = buffer_schema_peer.first;
        buffer_schema_connection.connected = 1;
        let buffer_schema_window: WaylandNativeWindow = wayland_keyboard_test_window(550, 551, 552, 553);
        buffer_schema_window.buffer_busy = 1;
        let bad_release: WireBuffer = wayland_u32_request(553, 0, 1);
        let _bad_release_sent: i64 = linux_send_wire(buffer_schema_peer.second, &bad_release);
        let buffer_schema_ok: i32 = wayland_wait_buffer_release(&buffer_schema_connection,
            &buffer_schema_window, 100);
        failures = failures + wayland_keyboard_expect(buffer_schema_ok == 0
            && buffer_schema_window.buffer_busy == 1
            && buffer_schema_connection.connected == 0,
            "malformed wl_buffer.release cannot release a busy buffer");
        wire_free(&bad_release); wayland_disconnect(&buffer_schema_connection);
        let _close_buffer_schema_peer: i64 = linux_close(buffer_schema_peer.second);
    } else { failures = failures + wayland_keyboard_expect(0, "buffer schema fixture opens"); }

    let buffer_close_peer: LinuxFdPair = linux_socketpair_stream();
    if (buffer_close_peer.ok == 1) {
        let buffer_close_connection: WaylandNativeConnection = wayland_empty_connection();
        buffer_close_connection.fd = buffer_close_peer.first;
        buffer_close_connection.connected = 1;
        let buffer_close_window: WaylandNativeWindow = wayland_keyboard_test_window(
            554, 555, 556, 557);
        buffer_close_window.buffer_busy = 1;
        let buffer_wait_close: WireBuffer = wayland_empty_request(556, 1);
        let buffer_wait_release: WireBuffer = wayland_empty_request(557, 0);
        let _buffer_wait_close_sent: i64 = linux_send_wire(
            buffer_close_peer.second, &buffer_wait_close);
        let _buffer_wait_release_sent: i64 = linux_send_wire(
            buffer_close_peer.second, &buffer_wait_release);
        let buffer_close_ok: i32 = wayland_wait_buffer_release(
            &buffer_close_connection, &buffer_close_window, 500);
        let deferred_buffer_close: WaylandNativePendingEvent =
            wayland_connection_take_pending_event(&buffer_close_connection);
        let deferred_buffer_close_frame: WaylandFrame = wayland_decode(
            &deferred_buffer_close.input, 0);
        failures = failures + wayland_keyboard_expect(buffer_close_ok == 1
            && buffer_close_window.buffer_busy == 0
            && buffer_close_window.close_requested == 0
            && deferred_buffer_close.valid == 1
            && deferred_buffer_close.kind == WaylandNativePendingKind.Frame
            && deferred_buffer_close_frame.object_id == 556
            && deferred_buffer_close_frame.opcode == 1,
            "buffer-release wait preserves target close for ordered app dispatch");
        wayland_native_pending_event_free(&deferred_buffer_close);
        wire_free(&buffer_wait_close); wire_free(&buffer_wait_release);
        wayland_disconnect(&buffer_close_connection);
        let _close_buffer_close_peer: i64 = linux_close(buffer_close_peer.second);
    } else {
        failures = failures + wayland_keyboard_expect(0,
            "buffer close queue fixture opens a Unix socketpair");
    }

    let ping_peer: LinuxFdPair = linux_socketpair_stream();
    if (ping_peer.ok == 1) {
        let ping_connection: WaylandNativeConnection = wayland_empty_connection();
        ping_connection.fd = ping_peer.first; ping_connection.connected = 1;
        ping_connection.wm_base_id = 560;
        let ping_window: WaylandNativeWindow = wayland_keyboard_test_window(561, 562, 563, 564);
        ping_window.buffer_busy = 1;
        let ping_wire: WireBuffer = wayland_u32_request(560, 0, 9);
        let _ping_sent: i64 = linux_send_wire(ping_peer.second, &ping_wire);
        let _ping_peer_closed: i64 = linux_close(ping_peer.second);
        let ping_started: i64 = linux_monotonic_ms();
        let ping_ok: i32 = wayland_wait_buffer_release(&ping_connection, &ping_window, 500);
        let ping_elapsed: i64 = linux_monotonic_ms() - ping_started;
        failures = failures + wayland_keyboard_expect(ping_ok == 0
            && ping_connection.connected == 0 && ping_connection.fd < 0
            && ping_elapsed <= 200,
            "failed pong retires immediately instead of spinning to the wait deadline");
        wire_free(&ping_wire); wayland_disconnect(&ping_connection);
    } else { failures = failures + wayland_keyboard_expect(0, "ping liveness fixture opens"); }

    if (failures != 0) { return 1; }
    _zag_println("wayland_keyboard_test: ok");
    return 0;
}
