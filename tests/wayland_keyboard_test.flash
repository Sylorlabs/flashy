            && get_device_frame.valid != 0
            && get_device_frame.object_id == 8
            && get_device_frame.opcode == 1 && get_device_frame.size == 16
            && wire_read_u32_le(&get_device_call,
                get_device_frame.payload_offset) == 9
            && wire_read_u32_le(&get_device_call,
                get_device_frame.payload_offset + 4) == 7
            && bind_connection.clipboard_manager_id == 8
            && bind_connection.clipboard_device_id == 9
