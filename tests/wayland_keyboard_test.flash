    let count_connection: WaylandNativeConnection = wayland_empty_connection();
    let count_ok: i32 = 1;
    let count_i: t27 = 1;
    while (count_i <= wayland_registry_max_globals()) {
        let counted: WaylandGlobal = wayland_keyboard_test_global(count_i, "x");
        if (wayland_record_global(&count_connection, counted) == 0) { count_ok = 0; }
        count_i = count_i + 1;
