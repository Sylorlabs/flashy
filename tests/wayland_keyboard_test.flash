            && bind_seat_frame.valid == 1 && bind_seat_frame.object_id == 2
            && bind_seat_frame.opcode == 0
            && wire_read_u32_le(&bind_seat_call,
                bind_seat_frame.payload_offset + 16) == 3
            && bind_clipboard_frame.valid != 0
            && bind_clipboard_frame.object_id == 2
            && bind_clipboard_frame.opcode == 0
            && wire_read_u32_le(&bind_clipboard_call,
