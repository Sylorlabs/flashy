// Normalized deterministic input dispatch over the retained semantic tree.

enum TextEditCommand { MovePrevious, MoveNext, MoveStart, MoveEnd, DeletePrevious, DeleteNext, SelectAll }

// Selection positions are logical grapheme indices. Anchor is the fixed edge;
// focus is the active edge mirrored by Node.caret.
struct TextSelection {
    anchor: t27,
    focus: t27,
}

fn rect_axis_contains(start: t27, extent: t27, value: t27) i32 {
    if (extent <= 0 || value < start) { return 0; }
    if (start > flashy_t27_max() - extent) { return 0; }
    if (start >= 0 || value < 0) {
        // Same-sign ordered subtraction cannot leave the t27 range.
        return (value - start) < extent;
    }
    // start is negative and value is nonnegative. Compare the two bounded
    // pieces of the distance without adding them together.
    let distance_to_zero: t27 = 0 - start;
    if (extent <= distance_to_zero) { return 0; }
    return value < extent - distance_to_zero;
}

fn rect_contains(r: Rect, x: t27, y: t27) i32 {
    if (rect_axis_contains(r.x, r.w, x) == 0
        || rect_axis_contains(r.y, r.h, y) == 0) { return 0; }
    return 1;
}

fn rect_center_checked(r: Rect, x: *t27, y: *t27) i32 {
    if (r.w <= 0 || r.h <= 0) { return 0; }
    if (r.x > flashy_t27_max() - r.w
        || r.y > flashy_t27_max() - r.h) { return 0; }
    let half_w: t27 = r.w / 2;
    let half_h: t27 = r.h / 2;
    if (r.x > flashy_t27_max() - half_w
        || r.y > flashy_t27_max() - half_h) { return 0; }
    x.* = r.x + half_w;
    y.* = r.y + half_h;
    return 1;
}

fn node_interactive(n: Node) i32 {
    if (n.live == 0 || n.style.visible == 0 || n.style.enabled == 0) { return 0; }
    if (n.semantics.role == Role.Button || n.semantics.role == Role.Checkbox || n.semantics.role == Role.Radio
        || n.semantics.role == Role.Slider || n.semantics.role == Role.TextField || n.semantics.role == Role.Tab
        || n.semantics.role == Role.MenuItem) { return 1; }
    return 0;
}

fn ui_hit_test(ui: *Ui, x: t27, y: t27) i32 {
    // Later declarations paint on top and therefore win hit testing.
    let i: i32 = len[Node](ui.*.nodes) - 1;
    while (i >= 0) {
        let n: Node = get[Node](ui.*.nodes, i);
        if (node_interactive(n) == 1 && rect_contains(n.bounds, x, y) == 1) { return i; }
        i = i - 1;
    }
    return -1;
}

fn ui_set_focus(ui: *Ui, node_id: i32) i32 {
    if (node_id >= 0) {
        if (node_id >= len[Node](ui.*.nodes) || node_interactive(get[Node](ui.*.nodes, node_id)) == 0) { return 0; }
    }
    let i: i32 = 0;
    while (i < len[Node](ui.*.nodes)) {
        let n: Node = get[Node](ui.*.nodes, i);
        let next: i32 = 0;
        if (i == node_id) { next = 1; }
        if (n.focused != next) { n.focused = next; n.dirty_paint = 1; set[Node](&ui.*.nodes, i, n); }
        i = i + 1;
    }
    ui.*.focused_node = node_id;
    return 1;
}

fn ui_focus_next(ui: *Ui, backwards: i32) i32 {
    let count: i32 = len[Node](ui.*.nodes);
    if (count == 0) { return 0; }
    let i: i32 = ui.*.focused_node;
    let visited: i32 = 0;
    while (visited < count) {
        if (backwards == 1) { i = i - 1; if (i < 0) { i = count - 1; } }
        else { i = i + 1; if (i >= count) { i = 0; } }
        if (node_interactive(get[Node](ui.*.nodes, i)) == 1) { return ui_set_focus(ui, i); }
        visited = visited + 1;
    }
    return 0;
}

fn ui_set_hover(ui: *Ui, node_id: i32) void {
    let i: i32 = 0;
    while (i < len[Node](ui.*.nodes)) {
        let n: Node = get[Node](ui.*.nodes, i);
        let next: i32 = 0;
        if (i == node_id) { next = 1; }
        if (n.hovered != next) { n.hovered = next; n.dirty_paint = 1; set[Node](&ui.*.nodes, i, n); }
        i = i + 1;
    }
    ui.*.hovered_node = node_id;
}

fn ui_notify_handlers(ui: *Ui, node: Node, event: Event) void {
    let handler_i: i32 = 0;
    while (handler_i < len[HandlerBinding](ui.*.handlers)) {
        let binding: HandlerBinding = get[HandlerBinding](ui.*.handlers, handler_i);
        if (binding.live == 1 && binding.node_key == node.key) {
            binding.context.ui = ui; binding.context.node_key = node.key;
            binding.context.event_count = binding.context.event_count + 1;
            // Publish call bookkeeping before invoking user code. The callback
            // may unbind, rebind, or unmount this slot, so its post-callback
            // contents are authoritative and must never be replaced by this
            // pre-call copy.
            set[HandlerBinding](&ui.*.handlers, handler_i, binding);
            binding.handler(&binding.context, event);
        }
        handler_i = handler_i + 1;
    }
}

fn text_selection_start(selection: TextSelection) t27 {
    if (selection.anchor < selection.focus) { return selection.anchor; }
    return selection.focus;
}

fn text_selection_end(selection: TextSelection) t27 {
    if (selection.anchor > selection.focus) { return selection.anchor; }
    return selection.focus;
}

fn text_selection_collapsed(selection: TextSelection) i32 {
    if (selection.anchor == selection.focus) { return 1; }
    return 0;
}

fn text_node_storage_valid(node: *Node) i32 {
    if (node.*.live == 0 || node.*.kind != NodeKind.TextField || node.*.semantics.role != Role.TextField) { return 0; }
    let value: []u8 = text_buffer_view(&node.*.text_buffer);
    if (text_field_value_valid(value) == 0 || @strEq(node.*.text, value) == 0
        || @strEq(node.*.semantics.value, value) == 0) { return 0; }
    if (selection_valid(value, node.*.selection_start, node.*.selection_end) == 0) { return 0; }
    if (node.*.caret != node.*.selection_start && node.*.caret != node.*.selection_end) { return 0; }
    return 1;
}

fn editable_text_node_valid(node: *Node) i32 {
    if (text_node_storage_valid(node) == 0 || node.*.style.enabled == 0) { return 0; }
    return 1;
}

fn ui_get_text_selection(ui: *Ui, node_id: i32) TextSelection {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) {
        return TextSelection{ .anchor = -1, .focus = -1 };
    }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (text_node_storage_valid(&node) == 0) { return TextSelection{ .anchor = -1, .focus = -1 }; }
    let anchor: t27 = node.selection_start;
    if (node.selection_start != node.selection_end && node.caret == node.selection_start) {
        anchor = node.selection_end;
    }
    return TextSelection{ .anchor = anchor, .focus = node.caret };
}

fn ui_set_text_selection(ui: *Ui, node_id: i32, selection: TextSelection) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (editable_text_node_valid(&node) == 0) { return 0; }
    let start: t27 = text_selection_start(selection);
    let end: t27 = text_selection_end(selection);
    let value: []u8 = text_buffer_view(&node.text_buffer);
    if (selection_valid(value, start, end) == 0) { return 0; }
    if (node.caret != selection.focus || node.selection_start != start || node.selection_end != end) {
        node.caret = selection.focus; node.selection_start = start; node.selection_end = end;
        node.dirty_paint = 1; set[Node](&ui.*.nodes, node_id, node);
    }
    return 1;
}

fn ui_copy_selected_text(ui: *Ui, node_id: i32) TextBuffer {
    let empty: TextBuffer = text_buffer_empty();
    let start_byte: t27 = 0;
    let end_byte: t27 = 0;
    if (ui_selected_text_byte_range(ui, node_id,
        &start_byte, &end_byte) == 0) { return empty; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    let value: []u8 = text_buffer_view(&node.text_buffer);
    return text_buffer_copy(value[start_byte as i32..end_byte as i32]);
}

// Resolve selected graphemes to owned UTF-8 byte offsets without allocating.
// Outputs remain untouched on failure so clipboard and automation callers can
// preflight a bounded copy before acquiring any bytes.
fn ui_selected_text_byte_range(ui: *Ui, node_id: i32,
    start_byte: *t27, end_byte: *t27) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (text_node_storage_valid(&node) == 0) { return 0; }
    let value: []u8 = text_buffer_view(&node.text_buffer);
    let resolved_start: t27 = utf8_grapheme_byte_offset(
        value, node.selection_start);
    let resolved_end: t27 = utf8_grapheme_byte_offset(
        value, node.selection_end);
    if (resolved_start < 0 || resolved_end < resolved_start
        || resolved_end > value.len as t27) { return 0; }
    start_byte.* = resolved_start;
    end_byte.* = resolved_end;
    return 1;
}

// Commit consumes next.bytes on success. Callers may always free next after the
// call because text_buffer_take leaves the source empty. Input callbacks receive
// an independent copy so reentrant edits cannot invalidate Event.text.
fn ui_commit_text_buffer(ui: *Ui, node_id: i32, next: *TextBuffer, selection: TextSelection) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (editable_text_node_valid(&node) == 0) { return 0; }
    let next_value: []u8 = text_buffer_view(next);
    let start: t27 = text_selection_start(selection);
    let end: t27 = text_selection_end(selection);
    if (text_field_value_valid(next_value) == 0
        || selection_valid(next_value, start, end) == 0) { return 0; }

    let changed: i32 = 0;
    if (text_buffer_equal(&node.text_buffer, next_value) == 0) { changed = 1; }
    let selection_changed: i32 = 0;
    if (node.caret != selection.focus || node.selection_start != start || node.selection_end != end) {
        selection_changed = 1;
    }
    let old: TextBuffer = node.text_buffer;
    node.text_buffer = text_buffer_take(&next.*.bytes);
    node.text = text_buffer_view(&node.text_buffer); node.semantics.value = node.text;
    node.caret = selection.focus; node.selection_start = start; node.selection_end = end;
    if (changed == 1 || selection_changed == 1) { node.dirty_paint = 1; }
    set[Node](&ui.*.nodes, node_id, node);
    text_buffer_free(&old);

    if (changed == 1) {
        if (node.action.id != 0) { push[t9](&ui.*.emitted_actions, node.action.id); }
        let callback_text: TextBuffer = text_buffer_copy(node.text);
        let input_event: Event = event_new(EventKind.Input, node.bounds.x, node.bounds.y);
        input_event.text = text_buffer_view(&callback_text);
        ui_notify_handlers(ui, node, input_event);
        text_buffer_free(&callback_text);
    }
    return 1;
}

fn ui_set_text_value(ui: *Ui, node_id: i32, value: []u8) i32 {
    if (text_field_value_valid(value) == 0) { return 0; }
    let next: TextBuffer = text_buffer_copy(value);
    let end: t27 = utf8_grapheme_count(value);
    let result: i32 = ui_commit_text_buffer(ui, node_id, &next, TextSelection{ .anchor = end, .focus = end });
    text_buffer_free(&next);
    return result;
}

fn ui_replace_text_range(ui: *Ui, node_id: i32, start: t27, end: t27, value: []u8) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)
        || text_field_value_valid(value) == 0) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (editable_text_node_valid(&node) == 0) { return 0; }
    let current: []u8 = text_buffer_view(&node.text_buffer);
    if (selection_valid(current, start, end) == 0) { return 0; }
    let start_byte: t27 = utf8_grapheme_byte_offset(current, start);
    let end_byte: t27 = utf8_grapheme_byte_offset(current, end);
    if (start_byte < 0 || end_byte < start_byte) { return 0; }
    let next_len: t27 = 0;
    if (text_replacement_length_checked(current.len as t27,
        start_byte, end_byte, value.len as t27, text_field_max_bytes(),
        &next_len) == 0) { return 0; }
    let next: TextBuffer = text_buffer_copy(current);
    if (text_buffer_replace_range(&next, start_byte, end_byte, value) == 0) {
        text_buffer_free(&next); return 0;
    }
    // Resolve the insertion end in the final buffer. Counting the replacement
    // in isolation is wrong when it joins a preceding/following cluster (for
    // example a combining mark, regional indicator, or ZWJ continuation).
    let insertion_end_byte: t27 = start_byte + value.len as t27;
    let focus: t27 = utf8_grapheme_index_at_or_after_byte(text_buffer_view(&next), insertion_end_byte);
    if (focus < 0) { text_buffer_free(&next); return 0; }
    let result: i32 = ui_commit_text_buffer(ui, node_id, &next,
        TextSelection{ .anchor = focus, .focus = focus });
    text_buffer_free(&next);
    return result;
}

fn ui_replace_text_selection(ui: *Ui, node_id: i32, value: []u8) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (editable_text_node_valid(&node) == 0) { return 0; }
    return ui_replace_text_range(ui, node_id, node.selection_start, node.selection_end, value);
}

fn ui_insert_text(ui: *Ui, node_id: i32, value: []u8) i32 {
    return ui_replace_text_selection(ui, node_id, value);
}

fn ui_apply_text_command(ui: *Ui, node_id: i32, command: TextEditCommand, extend: i32) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (editable_text_node_valid(&node) == 0) { return 0; }
    let current: TextSelection = ui_get_text_selection(ui, node_id);
    let count: t27 = utf8_grapheme_count(text_buffer_view(&node.text_buffer));

    if (command == TextEditCommand.DeletePrevious || command == TextEditCommand.DeleteNext) {
        if (node.selection_start != node.selection_end) {
            return ui_replace_text_range(ui, node_id, node.selection_start, node.selection_end, "");
        }
        if (command == TextEditCommand.DeletePrevious) {
            if (current.focus <= 0) { return 0; }
            return ui_replace_text_range(ui, node_id, current.focus - 1, current.focus, "");
        }
        if (current.focus >= count) { return 0; }
        return ui_replace_text_range(ui, node_id, current.focus, current.focus + 1, "");
    }
    if (command == TextEditCommand.SelectAll) {
        return ui_set_text_selection(ui, node_id, TextSelection{ .anchor = 0, .focus = count });
    }

    let focus: t27 = current.focus;
    if (command == TextEditCommand.MovePrevious) {
        if (extend == 0 && text_selection_collapsed(current) == 0) { focus = node.selection_start; }
        else if (focus > 0) { focus = focus - 1; }
    } else if (command == TextEditCommand.MoveNext) {
        if (extend == 0 && text_selection_collapsed(current) == 0) { focus = node.selection_end; }
        else if (focus < count) { focus = focus + 1; }
    } else if (command == TextEditCommand.MoveStart) {
        focus = 0;
    } else if (command == TextEditCommand.MoveEnd) {
        focus = count;
    }
    let anchor: t27 = focus;
    if (extend != 0) { anchor = current.anchor; }
    return ui_set_text_selection(ui, node_id, TextSelection{ .anchor = anchor, .focus = focus });
}

fn ui_delete_grapheme_backward(ui: *Ui, node_id: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.DeletePrevious, 0);
}

fn ui_delete_grapheme_forward(ui: *Ui, node_id: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.DeleteNext, 0);
}

fn ui_move_caret_previous(ui: *Ui, node_id: i32, extend: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.MovePrevious, extend);
}

fn ui_move_caret_next(ui: *Ui, node_id: i32, extend: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.MoveNext, extend);
}

fn ui_move_caret_start(ui: *Ui, node_id: i32, extend: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.MoveStart, extend);
}

fn ui_move_caret_end(ui: *Ui, node_id: i32, extend: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.MoveEnd, extend);
}

fn ui_select_all_text(ui: *Ui, node_id: i32) i32 {
    return ui_apply_text_command(ui, node_id, TextEditCommand.SelectAll, 0);
}

fn ui_update_slider_at(ui: *Ui, node_id: i32, x: t27) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (node.semantics.role != Role.Slider || node.bounds.w < 1 || node.semantics.has_range == 0) { return 0; }
    let relative: t27 = x - node.bounds.x;
    if (relative < 0) { relative = 0; }
    if (relative > node.bounds.w) { relative = node.bounds.w; }
    node.value = node.semantics.range_min
        + ((node.semantics.range_max - node.semantics.range_min) * relative) / node.bounds.w;
    node.semantics.range_current = node.value; node.dirty_paint = 1;
    set[Node](&ui.*.nodes, node_id, node); return 1;
}

fn ui_scroll_node(ui: *Ui, node_id: i32, amount: t27) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (node.live == 0 || node.kind != NodeKind.Scroll) { return 0; }
    let current: t27 = node.scroll_y;
    if (current < 0) { current = 0; }
    let next: t27 = current;
    if (amount > 0) {
        if (current > flashy_t27_max() - amount) { next = flashy_t27_max(); }
        else { next = current + amount; }
    } else if (amount < 0) {
        let magnitude: t27 = 0 - amount;
        if (magnitude >= current) { next = 0; }
        else { next = current - magnitude; }
    }
    node.scroll_y = next; node.dirty_layout = 1; node.dirty_paint = 1;
    set[Node](&ui.*.nodes, node_id, node);
    let scroll_event: Event = event_new(EventKind.Scroll, node.bounds.x, node.bounds.y);
    scroll_event.detail = amount;
    ui_notify_handlers(ui, node, scroll_event);
    return 1;
}

fn ui_emit_node_action(ui: *Ui, node_id: i32) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let n: Node = get[Node](ui.*.nodes, node_id);
    if (node_interactive(n) == 0) { return 0; }
    if (n.semantics.role == Role.Checkbox) {
        if (n.value == 0) { n.value = 1; } else { n.value = 0; }
        n.dirty_paint = 1;
        set[Node](&ui.*.nodes, node_id, n);
    }
    if (n.semantics.role == Role.Radio) {
        n.value = 1; n.dirty_paint = 1; set[Node](&ui.*.nodes, node_id, n);
    }
    if (n.action.id != 0) { push[t9](&ui.*.emitted_actions, n.action.id); }
    ui_notify_handlers(ui, n, event_new(EventKind.Click, n.bounds.x, n.bounds.y));
    return 1;
}

// Commit both activations before invoking user callbacks, then deliver the two
// Click notifications followed by one DoubleClick notification. A callback
// may disable or unmount the node, but the automation operation cannot return
// failure after publishing only one of its two retained actions.
fn ui_emit_node_double_action(ui: *Ui, node_id: i32) i32 {
    if (node_id < 0 || node_id >= len[Node](ui.*.nodes)) { return 0; }
    let node: Node = get[Node](ui.*.nodes, node_id);
    if (node_interactive(node) == 0) { return 0; }
    if (node.semantics.role == Role.Radio) {
        node.value = 1; node.dirty_paint = 1;
        set[Node](&ui.*.nodes, node_id, node);
    }
    // A checkbox is toggled twice, so its retained value is unchanged.
    if (node.semantics.role == Role.Checkbox) { node.dirty_paint = 1; }
    if (node.action.id != 0) {
        push[t9](&ui.*.emitted_actions, node.action.id);
        push[t9](&ui.*.emitted_actions, node.action.id);
    }
    let click: Event = event_new(EventKind.Click, node.bounds.x, node.bounds.y);
    ui_notify_handlers(ui, node, click);
    ui_notify_handlers(ui, node, click);
    ui_notify_handlers(ui, node,
        event_new(EventKind.DoubleClick, node.bounds.x, node.bounds.y));
    return 1;
}

fn ui_dispatch(ui: *Ui, event: Event) i32 {
    if (event.kind == EventKind.Hover) {
        ui_set_hover(ui, ui_hit_test(ui, event.x, event.y));
        return 1;
    }
    if (event.kind == EventKind.PointerDown) {
        let hit: i32 = ui_hit_test(ui, event.x, event.y);
        ui.*.pressed_node = hit;
        if (hit >= 0) {
            let n: Node = get[Node](ui.*.nodes, hit);
            n.pressed = 1; n.dirty_paint = 1; set[Node](&ui.*.nodes, hit, n);
            let focused: i32 = ui_set_focus(ui, hit);
            return 1;
        }
        return 0;
    }
    if (event.kind == EventKind.PointerUp) {
        let hit: i32 = ui_hit_test(ui, event.x, event.y);
        let pressed: i32 = ui.*.pressed_node;
        if (pressed >= 0 && pressed < len[Node](ui.*.nodes)) {
            let n: Node = get[Node](ui.*.nodes, pressed);
            n.pressed = 0; n.dirty_paint = 1; set[Node](&ui.*.nodes, pressed, n);
        }
        ui.*.pressed_node = -1;
        if (pressed >= 0 && hit == pressed) {
            let _slider_updated: i32 = ui_update_slider_at(ui, hit, event.x);
            return ui_emit_node_action(ui, hit);
        }
        return 0;
    }
    if (event.kind == EventKind.Click) {
        return ui_emit_node_action(ui, ui_hit_test(ui, event.x, event.y));
    }
    if (event.kind == EventKind.DoubleClick) {
        return ui_emit_node_double_action(ui, ui_hit_test(ui, event.x, event.y));
    }
    if (event.kind == EventKind.Press) {
        if (event.key == Key.Tab && event.modifiers.control == 0
            && event.modifiers.alt == 0 && event.modifiers.meta == 0) {
            return ui_focus_next(ui, event.modifiers.shift as i32);
        }
        if (ui.*.focused_node >= 0) {
            if (event.key == Key.A && event.modifiers.alt == 0
                && (event.modifiers.control != 0 || event.modifiers.meta != 0)) {
                return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.SelectAll, 0);
            }
            if (event.modifiers.control == 0 && event.modifiers.alt == 0 && event.modifiers.meta == 0) {
                if (event.key == Key.Backspace) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.DeletePrevious, 0);
                }
                if (event.key == Key.Delete) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.DeleteNext, 0);
                }
                if (event.key == Key.ArrowLeft) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.MovePrevious,
                        event.modifiers.shift as i32);
                }
                if (event.key == Key.ArrowRight) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.MoveNext,
                        event.modifiers.shift as i32);
                }
                if (event.key == Key.Home) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.MoveStart,
                        event.modifiers.shift as i32);
                }
                if (event.key == Key.End) {
                    return ui_apply_text_command(ui, ui.*.focused_node, TextEditCommand.MoveEnd,
                        event.modifiers.shift as i32);
                }
            }
        }
        if ((event.key == Key.Enter || event.key == Key.Space)
            && event.modifiers.shift == 0 && event.modifiers.control == 0
            && event.modifiers.alt == 0 && event.modifiers.meta == 0) {
            if (ui.*.focused_node < 0) { return 0; }
            let focused: Node = get[Node](ui.*.nodes, ui.*.focused_node);
            if (focused.semantics.role == Role.TextField) { return 0; }
            return ui_emit_node_action(ui, ui.*.focused_node);
        }
    }
    if (event.kind == EventKind.Input && ui.*.focused_node >= 0) {
        // Empty producer frames carry no edit. They must not reinterpret a
        // current selection as a request to delete it.
        if (event.text.len == 0) { return 1; }
        return ui_insert_text(ui, ui.*.focused_node, event.text);
    }
    if (event.kind == EventKind.Scroll) {
        let i: i32 = len[Node](ui.*.nodes) - 1;
        while (i >= 0) {
            let node: Node = get[Node](ui.*.nodes, i);
            if (node.live == 1 && node.kind == NodeKind.Scroll && rect_contains(node.bounds, event.x, event.y) == 1) {
                return ui_scroll_node(ui, i, event.detail);
            }
            i = i - 1;
        }
    }
    return 0;
}
