// CPU Surface upload through wl_shm. Pixel bytes are isolated to this protocol boundary.

struct WaylandPresentResult {
    bytes: t27,
    ok: i32,
    error: []u8,
}

fn wayland_present_release_local_buffer(window: *WaylandNativeWindow) void {
    if (window.*.memory.valid == 1) { linux_shared_memory_free(&window.*.memory); }
    window.*.buffer_id = 0;
    window.*.buffer_width = 0;
    window.*.buffer_height = 0;
    window.*.buffer_busy = 0;
}

fn wayland_present_damage_request(surface_id: t27, width: t27, height: t27,
    compositor_version: t27) WireBuffer {
    if (compositor_version >= 4) {
        return wayland_surface_damage_buffer(surface_id, width, height);
    }
    return wayland_surface_damage(surface_id, width, height);
}

fn wayland_present_surface(connection: *WaylandNativeConnection, window: *WaylandNativeWindow,
    surface: *Surface) WaylandPresentResult {
    let result: WaylandPresentResult = WaylandPresentResult{ .bytes = 0, .ok = 0, .error = "presentation not attempted" };
    if (connection.*.connected == 0 || connection.*.shm_id == 0 || window.*.live == 0 || window.*.configured == 0) {
        result.error = "Wayland window is not configured"; return result;
    }
    if (window.*.buffer_busy == 1) { result.error = "Wayland buffer is awaiting release"; return result; }
    if (surface.*.width != window.*.width || surface.*.height != window.*.height) {
        result.error = "surface dimensions do not match Wayland window"; return result;
    }
    let stride: t27 = surface.*.width * 4;
    let byte_count: t27 = stride * surface.*.height;
    if (byte_count < 1 || byte_count > 2147483647) { result.error = "Wayland surface size is unsupported"; return result; }
    if (window.*.memory.valid == 1
        && (window.*.buffer_width != surface.*.width || window.*.buffer_height != surface.*.height)) {
        let destroy_ok: i32 = 1;
        if (window.*.buffer_id != 0) {
            let destroy_old_buffer: WireBuffer = wayland_empty_request(window.*.buffer_id, 0);
            destroy_ok = wayland_native_send_request(connection, &destroy_old_buffer, 1);
        }
        wayland_present_release_local_buffer(window);
        if (destroy_ok == 0) {
            result.error = "Wayland resized buffer destruction failed"; return result;
        }
    }
    if (window.*.memory.valid == 0) {
        if (wayland_native_client_ids_available(connection, 2, 0) == 0) {
            result.error = "Wayland client object ID capacity exhausted";
            return result;
        }
        window.*.memory = linux_shared_memory_create(byte_count as i64);
        if (window.*.memory.valid == 0) { result.error = "Wayland shared memory allocation failed"; return result; }
        let pool_id: t27 = wayland_native_take_client_ids(connection, 2);
        if (pool_id == 0) {
            wayland_present_release_local_buffer(window);
            result.error = "Wayland client object ID allocation failed";
            return result;
        }
        window.*.buffer_id = pool_id + 1;
        window.*.buffer_width = surface.*.width; window.*.buffer_height = surface.*.height;
        let create_pool: WireBuffer = wayland_shm_create_pool(connection.*.shm_id, pool_id, byte_count);
        if (wayland_native_send_request_fd(connection, &create_pool,
            window.*.memory.fd, 1) == 0) {
            wayland_present_release_local_buffer(window);
            result.error = "Wayland shm pool FD transfer failed"; return result;
        }
        let create_buffer: WireBuffer = wayland_shm_pool_create_buffer(pool_id, window.*.buffer_id,
            surface.*.width, surface.*.height, stride);
        let destroy_pool: WireBuffer = wayland_empty_request(pool_id, 1);
        let create_buffer_ok: i32 = wayland_native_send_request(
            connection, &create_buffer, 1);
        let destroy_pool_ok: i32 = wayland_native_send_request(
            connection, &destroy_pool, create_buffer_ok);
        if (destroy_pool_ok == 0) {
            wayland_present_release_local_buffer(window);
            result.error = "Wayland shm buffer creation failed"; return result;
        }
    }
    let pixel: t27 = 0;
    while (pixel < surface.*.width * surface.*.height) {
        let source: i32 = (pixel * 4) as i32;
        let target: i64 = (pixel * 4) as i64;
        linux_shared_memory_set_byte(&window.*.memory, target, get[u8](surface.*.pixels, source + 2) as t9);
        linux_shared_memory_set_byte(&window.*.memory, target + 1, get[u8](surface.*.pixels, source + 1) as t9);
        linux_shared_memory_set_byte(&window.*.memory, target + 2, get[u8](surface.*.pixels, source) as t9);
        linux_shared_memory_set_byte(&window.*.memory, target + 3, 255);
        pixel = pixel + 1;
    }
    let attach: WireBuffer = wayland_surface_attach(window.*.surface_id, window.*.buffer_id);
    let compositor_version: t27 = wayland_global_version(connection, connection.*.compositor_name);
    let damage: WireBuffer = wayland_present_damage_request(window.*.surface_id,
        surface.*.width, surface.*.height, compositor_version);
    let commit: WireBuffer = wayland_empty_request(window.*.surface_id, 6);
    let attach_ok: i32 = wayland_native_send_request(connection, &attach, 1);
    let damage_ok: i32 = wayland_native_send_request(connection, &damage, attach_ok);
    let commit_ok: i32 = wayland_native_send_request(connection, &commit, damage_ok);
    if (commit_ok == 0) {
        wayland_present_release_local_buffer(window);
        result.error = "Wayland surface attach/commit failed"; return result;
    }
    window.*.buffer_busy = 1; result.bytes = byte_count; result.ok = 1; result.error = ""; return result;
}
